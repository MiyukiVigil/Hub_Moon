// Hub Moon — the whole view.
//
// One rule runs through this file: **the view holds no maths and no policy.** It never
// converts a pixel to a frequency, never decides what a legal gain is, and never
// computes a curve. It reports fractions ("the pointer is 62% across the plot") and
// renders what bridge.py hands back — finished SVG commands, finished labels, finished
// handle positions. That is what keeps a curve the graph draws and a curve the DAC
// accepts the same curve: there is only one copy of the maths, and it is the one that
// writes to the hidraw.

import { Theme, Regions, Accents, Skins } from "theme.slint";
import { Icons } from "icons.slint";

// A Material Symbols glyph, drawn rather than shaped: `d` is an outline from
// icons.slint, which tools/build-icons.py extracts from the upstream font.
//
// This used to be a Text in a bundled icon font. It cannot be — Slint's Python API has
// no font-registration call, and SLINT_DEFAULT_FONT sets the default family rather than
// making one resolvable by name. Under a fontconfig sandbox without Material Symbols
// installed, every icon in this app rendered as its own name ("gr", "he", "rem"), which
// is what a clean install would have looked like. Outlines have no such failure mode.
// The glyph sits in a box that the layout is free to stretch, and centres itself
// inside it. Two things this is working around, both learned the hard way:
//
//   * A bare Path with a fixed height inside a HorizontalLayout is not centred on the
//     cross axis — it lands at the top and rides up over the container's border. The
//     Text this replaced filled the row and centred its glyph internally, which is the
//     behaviour every call site was written against; only `width` is fixed here so the
//     row can still give it its full height.
//   * The colour property is `tint`, not `color`, because Rectangle carries a
//     deprecated `color` alias for `background` — a `color:` at a call site would have
//     painted the box rather than the glyph.
component Sym inherits Rectangle {
    in property <string> d;
    in property <length> sz: 18px;
    in property <color> tint: Theme.text;
    width: root.sz;
    background: transparent;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.sz;
        height: root.sz;
        viewbox-width: 960;
        viewbox-height: 960;
        commands: root.d;
        fill: root.tint;
    }
}

// Every field here arrives finished. `hx`/`hy` are the handle's position as a fraction
// of the plot, `gain-frac` the slider's; the view multiplies them by its own pixels and
// asks no further questions.
export struct BandRow {
    index: int,
    type: string,
    abbr: string,
    frequency: int,
    freq-label: string,
    gain: float,
    gain-label: string,
    q: float,
    q-label: string,
    enabled: bool,
    region: string,
    hx: float,
    hy: float,
    gain-frac: float,
    at-limit: bool,
}

export struct PresetRow { name: string, icon: string }

// The Hub Moon mark: the same crescent-with-a-reading as the app icon and the welcome
// screen, at header size. Built from shapes rather than pulled from the icon set — this
// is the identity, and it should not be one symbol among thirty.
//
// The crescent is a disc with a second disc laid over it in the surface colour, which is
// why `behind` has to be told what it is sitting on, and why the root clips: without
// that the punch-out circle would paint over whatever is beside the mark.
component Mark inherits Rectangle {
    in property <length> size: 28px;
    in property <color> behind: Theme.card;
    width: root.size;
    height: root.size;
    clip: true;

    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: Theme.accent;
    }
    Rectangle {
        x: root.size * 0.30;
        y: -root.size * 0.08;
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: root.behind;
    }
    property <[float]> bars: [0.34, 0.62, 0.44, 0.78];
    for b[i] in root.bars: Rectangle {
        x: root.size * (0.36 + i * 0.15);
        y: root.size * (0.5 - b / 2);
        width: root.size * 0.09;
        height: root.size * b;
        border-radius: root.size * 0.045;
        background: Theme.accent;
    }
}

export struct ProfileRow {
    name: string,
    note: string,
}

// One thing that was applied recently. Keyed by fingerprint rather than name: two
// curves can share a name, and what is being pointed at is the curve.
export struct HistoryRow {
    fingerprint: string,
    name: string,
    note: string,
}

export struct AeqRow {
    model: string,
    source: string,
    form: string,
    // Filled in by the prefetch, a chunk at a time.
    shape: string,
    curve: string,
}

export struct HubRow {
    uuid: string,
    title: string,
    author: string,
    desc: string,
    likes: int,
    downloads: int,
    rating: float,
    ratings: int,
    // Filled in by the prefetch, a chunk at a time, after the row is already on
    // screen — so both are empty for a card whose curve has not arrived yet.
    shape: string,
    curve: string,
}

// One shape chip: what it is called and how many presets are that shape.
export struct ShapeRow {
    name: string,
    count: int,
}

// ── small parts ─────────────────────────────────────────────────────────────────
component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <length> sz: 16px;
    in property <bool> active: false;
    in property <color> tint: Theme.sub;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: self.width / 2;
    background: root.active ? Theme.accent-soft
              : (touch.has-hover ? Theme.card-2 : transparent);
    animate background { duration: Theme.quick; easing: Theme.ease-state; }

    Sym {
        d: root.icon;
        sz: root.sz;
        tint: root.active ? Theme.accent : root.tint;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component TextBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    // Icon only. A window narrower than the header's buttons want does not get a
    // header with the last button cut in half — it gets shorter buttons.
    in property <bool> compact: false;
    callback clicked();

    height: 32px;
    // `inner.preferred-width` already contains the padding below. Adding 26px on top
    // of it did not make the button roomier — it made it 26px too wide, and a
    // HorizontalLayout hands its slack to the last stretchy child, so all of it piled
    // up after the label. That is the "big border to the right of the text": the pill
    // was never sized to its contents, and the contents were never centred in it.
    width: inner.preferred-width;
    border-radius: 16px;
    opacity: root.enabled ? 1.0 : 0.42;
    background: root.primary
        ? (touch.has-hover ? Theme.text : Theme.accent)
        : (touch.has-hover ? Theme.card-2 : Theme.card);
    border-width: 1px;
    border-color: root.primary ? transparent : Theme.line-2;
    animate background { duration: Theme.quick; easing: Theme.ease-state; }

    inner := HorizontalLayout {
        // The real padding, in one place, rather than a small number here and a
        // larger correction on the width. `alignment: center` is the belt to that
        // brace: anywhere a caller does set an explicit width, the contents sit in
        // the middle of it instead of against the left edge.
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;
        Sym {
            d: root.icon;
            sz: 15px;
            width: root.icon == "" ? 0px : 15px;
            tint: root.primary ? Theme.accent-ink : Theme.sub;
        }
        if !root.compact: Text {
            text: root.label;
            color: root.primary ? Theme.accent-ink : Theme.text;
            font-size: 12px;
            font-weight: root.primary ? 700 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A button that reports being held rather than being clicked.
//
// Press-and-hold is the right shape for A/B: you are listening, not operating, and the
// answer to "which am I hearing" has to be the state of your thumb rather than
// something you look away from the music to read. `pressed` is watched with a changed
// handler rather than bound, because the callback has to fire on both edges — letting
// go is as much an instruction as pressing was.
component HoldBtn inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> held;
    callback changed(bool);

    height: 32px;
    // `inner.preferred-width` already contains the padding below. Adding 26px on top
    // of it did not make the button roomier — it made it 26px too wide, and a
    // HorizontalLayout hands its slack to the last stretchy child, so all of it piled
    // up after the label. That is the "big border to the right of the text": the pill
    // was never sized to its contents, and the contents were never centred in it.
    width: inner.preferred-width;
    border-radius: 16px;
    background: root.held ? Theme.bad
        : (touch.has-hover ? Theme.card-2 : Theme.card);
    border-width: 1px;
    border-color: root.held ? transparent : Theme.line-2;
    animate background { duration: Theme.quick; easing: Theme.ease-state; }

    inner := HorizontalLayout {
        // The real padding, in one place, rather than a small number here and a
        // larger correction on the width. `alignment: center` is the belt to that
        // brace: anywhere a caller does set an explicit width, the contents sit in
        // the middle of it instead of against the left edge.
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;
        Sym {
            d: root.icon;
            sz: 15px;
            width: 15px;
            tint: root.held ? Theme.bad-soft : Theme.sub;
        }
        Text {
            text: root.label;
            color: root.held ? Theme.bad-soft : Theme.text;
            font-size: 12px;
            font-weight: root.held ? 700 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        changed pressed => { root.changed(self.pressed); }
    }
}

// A horizontal value track. Reports a value in the caller's units — the mapping lives
// here so every call site stays plain dB.
component HTrack inherits Rectangle {
    in property <float> value;
    in property <float> minimum: -12;
    in property <float> maximum: 0;
    in property <color> fill: Theme.accent-line;
    in property <bool> enabled: true;
    callback moved(float);
    callback released();

    property <float> frac: (root.value - root.minimum) / max(0.001, root.maximum - root.minimum);

    // A groove and a thumb, not a progress bar. The difference is entirely in the
    // thumb: a filled track with a flat end reads as "how far along", which is a
    // readout; a raised thumb with a grip on it reads as "grab me", which is a control.
    height: 6px;
    border-radius: 3px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.line;

    Rectangle {
        x: 0px;
        width: parent.width * root.frac;
        height: parent.height;
        border-radius: 3px;
        background: root.fill;
    }
    thumb := Rectangle {
        x: parent.width * root.frac - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: drag.pressed ? 16px : 14px;
        height: 20px;
        border-radius: 7px;
        background: Theme.card;
        border-width: 2px;
        border-color: drag.pressed ? Theme.text : root.fill;
        animate width, border-color { duration: Theme.quick; easing: Theme.ease-state; }
        // grip: two hairlines, which is the whole visual grammar of "this slides"
        Rectangle {
            x: (parent.width - 5px) / 2; y: (parent.height - 8px) / 2;
            width: 1px; height: 8px; background: root.fill;
        }
        Rectangle {
            x: (parent.width + 3px) / 2; y: (parent.height - 8px) / 2;
            width: 1px; height: 8px; background: root.fill;
        }
    }
    drag := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        x: -8px;
        y: -11px;
        width: parent.width + 16px;
        height: 28px;
        // The pointer leaves the 6px groove vertically the moment a drag starts and
        // must keep dragging, so the hit area is deliberately taller than what is
        // painted, and inset by the same 8px it is widened by.
        property <float> at: max(0, min(1, ((self.mouse-x - 8px) / 1px) / max(1, parent.width / 1px)));
        moved => { root.moved(root.minimum + self.at * (root.maximum - root.minimum)); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved(root.minimum + self.at * (root.maximum - root.minimum));
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
    }
}

// One card in the control row: caption, optional warning chip, right-aligned readout,
// and the track under it.
component SliderCard inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <float> value;
    in property <float> minimum: -12;
    in property <float> maximum: 0;
    in property <string> readout;
    in property <bool> enabled: true;
    in property <bool> alert: false;
    in property <string> action;
    callback moved(float);
    callback released();
    callback action-clicked();

    height: 62px;
    border-radius: Theme.r-md;
    background: root.alert ? Theme.warn-soft : Theme.card;
    border-width: 1px;
    border-color: root.alert ? Theme.warn : Theme.line;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background, border-color { duration: Theme.settle; easing: Theme.ease-state; }

    VerticalLayout {
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 9px;
        padding-bottom: 11px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 7px;
            height: 15px;
            Text {
                text: root.label;
                color: root.alert ? Theme.warn : Theme.sub;
                font-family: Theme.mono;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Text {
                text: root.caption;
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 9px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.action != "": Rectangle {
                width: act.preferred-width + 16px;
                border-radius: 8px;
                background: fixt.has-hover ? Theme.warn : Theme.warn-soft;
                border-width: 1px;
                border-color: Theme.warn;
                act := Text {
                    text: root.action;
                    color: fixt.has-hover ? Theme.accent-ink : Theme.warn;
                    font-family: Theme.mono;
                    font-size: 9px;
                    font-weight: 700;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                fixt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action-clicked(); }
                }
            }
            Text {
                text: root.readout;
                color: root.alert ? Theme.warn : Theme.text;
                font-family: Theme.mono;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HTrack {
            value: root.value;
            minimum: root.minimum;
            maximum: root.maximum;
            enabled: root.enabled;
            fill: root.alert ? Theme.warn : Theme.accent-line;
            moved(v) => { root.moved(v); }
            released => { root.released(); }
        }
    }
}

// The device's own EQ profile slot. Not a preset — those fill the bands below; this
// picks which profile the DAC plays.
//
// The number here is what the DAC reported, never what was asked for. A DAWN PRO2 on
// firmware 1.5 accepts 0–4 and silently ignores anything above, so a control that
// counted its own clicks displayed profiles the device had refused — and once it had
// walked down to 4 there was no way back, because the custom profile has no settable
// index at all. Stepping is now a request; the reading comes from the device.
//
// `on-builtin` is the case that matters: the DAC is playing one of its own presets, so
// the bands below are that preset's and are not yours to edit. Getting back is a
// rewrite rather than a profile change, which is what the button says.
component SlotCard inherits Rectangle {
    in property <int> slot;
    in property <string> note;
    in property <bool> on-builtin;
    in property <bool> enabled: true;
    callback stepped(int);
    callback mine();

    height: 62px;
    border-radius: Theme.r-md;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.enabled ? 1.0 : 0.45;

    VerticalLayout {
        padding-left: 13px;
        padding-right: 9px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 2px;

        // The caption row carries the warning, because the row below it cannot: with
        // the recovery button in it there is about seven characters of room left, and
        // "the DAC's own preset" elided to "the …".
        Text {
            text: root.on-builtin ? "DEVICE SLOT · THE DAC’S OWN PRESET" : "DEVICE SLOT";
            color: root.on-builtin ? Theme.warn : Theme.sub;
            font-family: Theme.mono;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1px;
            height: 14px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.on-builtin ? "" : root.note;
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 9px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // Only drawn where it means something, and it is the whole recovery path:
            // there is no index that selects the custom profile, so "mine" writes the
            // bands back, and writing them is what selects it.
            if root.on-builtin: TextBtn {
                label: "my curve";
                icon: Icons.undo;
                clicked => { root.mine(); }
            }
            IconBtn {
                icon: Icons.remove;
                sz: 15px;
                clicked => { root.stepped(-1); }
            }
            Text {
                text: root.slot < 0 ? "—" : "\{root.slot}";
                color: Theme.text;
                font-family: Theme.mono;
                font-size: 17px;
                font-weight: 700;
                width: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            IconBtn {
                icon: Icons.add;
                sz: 15px;
                clicked => { root.stepped(1); }
            }
        }
    }
}

// ── the plot ────────────────────────────────────────────────────────────────────
// Geometry arrives finished: Python samples the biquads and hands over SVG commands,
// so there is no DSP in the view at all. `curve-path` and `flat-path` are computed
// against `plot-w`/`plot-h`, which this reports back on resize.
component ResponseGraph inherits Rectangle {
    in property <string> curve-path;
    in property <string> flat-path;
    in property <string> pregain-path;
    // The readout view: one curve, normalised to a 60 dB reference and with pre-gain
    // already paid — what actually leaves the DAC. Its grid is dashed, and the dashes
    // are cut in Python by the same code that dashes the output trace.
    in property <string> readout-path;
    in property <string> readout-flat-path;
    in property <string> readout-grid-path;
    in property <bool> readout: false;
    in property <[BandRow]> bands;
    in property <int> selected: -1;
    callback resized(length, length);
    callback press(float, float);
    callback move(float, float);
    callback release();
    callback scrolled(float);
    callback toggled();

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    property <length> gutter-l: 46px;
    property <length> gutter-b: 20px;
    property <length> gutter-t: 12px;
    property <length> plot-w: self.width - root.gutter-l - 10px;
    property <length> plot-h: self.height - root.gutter-t - root.gutter-b;

    changed plot-w => { root.resized(root.plot-w, root.plot-h); }
    changed plot-h => { root.resized(root.plot-w, root.plot-h); }

    // Named spectrum regions, tinted behind the curve. This is what the old build put
    // in a separate strip under the plot; behind it, a band's colour and its handle are
    // the same object and there is nothing to visually reconcile. The readout has none
    // of this — it is a chart to read, not a surface to work on.
    for r in Regions.all: Rectangle {
        visible: !root.readout;
        x: root.gutter-l + root.plot-w * r.at;
        y: root.gutter-t;
        width: root.plot-w * (r.to - r.at);
        height: root.plot-h;
        background: Theme.dark ? r.tint-dark : r.tint;
    }
    for r in Regions.all: Text {
        visible: !root.readout;
        x: root.gutter-l + root.plot-w * r.at;
        y: root.gutter-t + 4px;
        width: root.plot-w * (r.to - r.at);
        text: r.label;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 8px;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        overflow: elide;
    }

    // dB grid — labelled in the left gutter. The editor axis is symmetric, so every
    // gain the firmware will take is somewhere a handle can be dragged to. The readout
    // axis is the vendor chart's: 15 dB around a 60 dB reference.
    property <[{at: float, label: string, alt: string}]> db-marks: [
        { at: 0.00, label: "+12", alt: "+65dB" },
        { at: 0.25, label: "+6",  alt: "+60dB" },
        { at: 0.50, label: "0",   alt: "+55dB" },
        { at: 0.75, label: "-6",  alt: "+50dB" },
        { at: 1.00, label: "-12", alt: "+45dB" },
    ];
    for m in root.db-marks: Rectangle {
        // The readout draws its grid as one dashed Path instead, so the solid rules
        // here are for the editor only.
        visible: !root.readout && m.label != "";
        x: root.gutter-l;
        y: root.gutter-t + root.plot-h * m.at;
        width: root.plot-w;
        height: 1px;
        background: m.at == 0.5 ? Theme.line-2 : Theme.line;
        opacity: m.at == 0.5 ? 0.9 : 0.6;
    }
    for m in root.db-marks: Text {
        visible: root.readout ? m.alt != "" : m.label != "";
        x: 0px;
        y: root.gutter-t + root.plot-h * m.at - 7px;
        width: root.gutter-l - 8px;
        height: 14px;
        text: root.readout ? m.alt : m.label;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 10px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Frequency grid. `at` is (log10(f) - log10(20)) / 3 — the same log axis Python
    // samples the curve on, so a gridline and the curve point above it are the same
    // frequency. The previous values here were eyeballed and drifted by up to 2% of
    // the width, which put 50 Hz visibly left of where the curve turned.
    property <[{at: float, label: string, alt: string}]> f-marks: [
        { at: 0.0,     label: "20",  alt: "20Hz"   },
        { at: 0.13270, label: "50",  alt: "50Hz"   },
        { at: 0.23300, label: "100", alt: "100Hz"  },
        { at: 0.33270, label: "200", alt: "200Hz"  },
        { at: 0.46598, label: "500", alt: "500Hz"  },
        { at: 0.56600, label: "1k",  alt: "1KHz"   },
        { at: 0.66667, label: "2k",  alt: "2KHz"   },
        { at: 0.79930, label: "5k",  alt: "5KHz"   },
        { at: 0.89900, label: "10k", alt: "10KHz"  },
        { at: 1.0,     label: "20k", alt: "20KHz"  },
    ];
    for m in root.f-marks: Rectangle {
        visible: !root.readout;
        x: root.gutter-l + root.plot-w * m.at;
        y: root.gutter-t;
        width: 1px;
        height: root.plot-h;
        background: Theme.line;
        opacity: 0.45;
    }
    for m in root.f-marks: Text {
        // Clamped so the first and last labels stay inside the plot instead of being
        // clipped by it.
        x: min(root.gutter-l + root.plot-w - 40px,
               max(root.gutter-l, root.gutter-l + root.plot-w * m.at - 20px));
        y: root.gutter-t + root.plot-h + 3px;
        width: 40px;
        text: root.readout ? m.alt : m.label;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 10px;
        horizontal-alignment: center;
    }

    // the dashed readout grid
    Path {
        visible: root.readout;
        x: root.gutter-l;
        y: root.gutter-t;
        width: root.plot-w;
        height: root.plot-h;
        viewbox-width: root.plot-w / 1px;
        viewbox-height: root.plot-h / 1px;
        commands: root.readout-grid-path;
        stroke: Theme.line-2;
        stroke-width: 1px;
    }

    // the flat reference, then the output trace, then the equalised curve over both
    Path {
        x: root.gutter-l;
        y: root.gutter-t;
        width: root.plot-w;
        height: root.plot-h;
        viewbox-width: root.plot-w / 1px;
        viewbox-height: root.plot-h / 1px;
        commands: root.readout ? root.readout-flat-path : root.flat-path;
        stroke: Theme.flat;
        stroke-width: 1.5px;
    }
    // Output level: the same curve shifted by pre-gain. Its dashes are cut in Python,
    // because a stroke dash array is not something every Slint backend exposes.
    Path {
        visible: !root.readout;
        x: root.gutter-l;
        y: root.gutter-t;
        width: root.plot-w;
        height: root.plot-h;
        viewbox-width: root.plot-w / 1px;
        viewbox-height: root.plot-h / 1px;
        commands: root.pregain-path;
        stroke: Theme.pregain;
        stroke-width: 1.5px;
    }
    Path {
        x: root.gutter-l;
        y: root.gutter-t;
        width: root.plot-w;
        height: root.plot-h;
        viewbox-width: root.plot-w / 1px;
        viewbox-height: root.plot-h / 1px;
        commands: root.readout ? root.readout-path : root.curve-path;
        stroke: root.readout ? Theme.readout : Theme.curve;
        stroke-width: 2.5px;
    }

    // Handles. Purely decorative: hit-testing happens in Python, which is the only
    // place that knows where every band actually is. A ring rather than a filled dot,
    // so the curve stays readable underneath it.
    for b in root.bands: Rectangle {
        property <bool> on: b.index == root.selected;
        visible: b.enabled && !root.readout;
        x: root.gutter-l + root.plot-w * b.hx - (self.on ? 9px : 7px);
        y: root.gutter-t + root.plot-h * b.hy - (self.on ? 9px : 7px);
        width: self.on ? 18px : 14px;
        height: self.width;
        border-radius: self.width / 2;
        background: self.on ? Theme.accent : Theme.card;
        border-width: 2.5px;
        border-color: self.on ? Theme.accent : Theme.curve;
        animate width, background, border-color { duration: Theme.quick; easing: Theme.ease-state; }
        Text {
            text: "\{b.index + 1}";
            color: parent.on ? Theme.accent-ink : Theme.curve;
            font-family: Theme.mono;
            font-size: 9px;
            font-weight: 700;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // legend
    VerticalLayout {
        visible: !root.readout;
        x: root.gutter-l + 8px;
        y: root.gutter-t + root.plot-h - 52px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px; height: 13px;
            Rectangle { width: 15px; height: 1.5px; background: Theme.flat; y: 6px; }
            Text { text: "Flat"; color: Theme.faint; font-family: Theme.mono; font-size: 10px; }
        }
        HorizontalLayout {
            spacing: 6px; height: 13px;
            Rectangle { width: 15px; height: 2.5px; background: Theme.curve; y: 5px; }
            Text { text: "Equalized"; color: Theme.faint; font-family: Theme.mono; font-size: 10px; }
        }
        Rectangle {
            height: 13px;
            Rectangle { x: 0px;  y: 6px; width: 5px; height: 1.5px; background: Theme.pregain; }
            Rectangle { x: 7px;  y: 6px; width: 5px; height: 1.5px; background: Theme.pregain; }
            Text {
                x: 21px; y: 0px;
                text: "+ pre-gain (output)";
                color: Theme.faint; font-family: Theme.mono; font-size: 10px;
                vertical-alignment: center; height: 13px;
            }
        }
    }

    // One touch surface over the whole plot, on top of everything. It reports where
    // the pointer is as a fraction and nothing else; Python decides which handle that
    // grabbed, whether it may move there, and when to write. Off in the readout,
    // which is a chart and not an editor.
    plot-touch := TouchArea {
        enabled: !root.readout;
        x: root.gutter-l;
        y: root.gutter-t;
        width: root.plot-w;
        height: root.plot-h;
        mouse-cursor: pointer;
        property <float> fx: max(0, min(1, (self.mouse-x / 1px) / max(1, root.plot-w / 1px)));
        property <float> fy: max(0, min(1, (self.mouse-y / 1px) / max(1, root.plot-h / 1px)));
        moved => { root.move(self.fx, self.fy); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.press(self.fx, self.fy); }
            if (e.kind == PointerEventKind.up) { root.release(); }
        }
        scroll-event(e) => {
            root.scrolled(e.delta-y / 1px);
            return EventResult.accept;
        }
    }

    // Two views of the same maths, because they answer different questions. The editor
    // shows what each band does and lets you drag it; the readout is the vendor chart's
    // framing — one curve, normalised, pre-gain paid, which is what the DAC outputs.
    // Neither substitutes for the other, so it is a toggle rather than a replacement.
    Rectangle {
        x: parent.width - 34px;
        y: 8px;
        width: 28px;
        height: 24px;
        border-radius: 12px;
        background: gm.has-hover ? Theme.accent-soft : Theme.bg;
        border-width: 1px;
        border-color: root.readout ? Theme.accent : Theme.line;
        animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }
        Sym {
            d: root.readout ? Icons.tune : Icons.show-chart;
            sz: 14px;
            tint: root.readout ? Theme.accent : Theme.faint;
            width: 100%;
            height: 100%;
        }
        gm := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    }
}

// ── a band card in the strip under the plot ─────────────────────────────────────
component VTrack inherits Rectangle {
    in property <float> frac;          // 0 at the bottom of the range, 1 at the top
    in property <float> zero: 0.5;
    in property <color> fill: Theme.accent;
    in property <bool> enabled: true;
    callback moved(float);             // reports a fraction, same units as `frac`
    callback released();

    width: 34px;

    // Tick marks either side of the groove, at the quarters. A fader with nothing to
    // read against is a slider you cannot aim; these are what make +6 land on +6.
    property <[float]> ticks: [0.0, 0.25, 0.5, 0.75, 1.0];
    for t in root.ticks: Rectangle {
        x: 0px;
        y: (parent.height - 1px) * (1 - t);
        width: t == 0.5 ? 34px : 8px;
        height: 1px;
        background: t == 0.5 ? Theme.line-2 : Theme.line;
    }
    for t in root.ticks: Rectangle {
        x: parent.width - (t == 0.5 ? 0px : 8px);
        y: (parent.height - 1px) * (1 - t);
        width: t == 0.5 ? 0px : 8px;
        height: 1px;
        background: Theme.line;
    }

    track := Rectangle {
        x: (parent.width - 8px) / 2;
        width: 8px;
        height: 100%;
        border-radius: 4px;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.line;

        // Fill runs from zero to the value, in whichever direction that is — a cut
        // draws downward, a boost upward. A fader that always fills from the bottom
        // makes −6 dB look like "a bit of gain" instead of a cut.
        Rectangle {
            y: min(parent.height * (1 - root.zero), parent.height * (1 - root.frac));
            height: abs(parent.height * (root.frac - root.zero));
            width: parent.width;
            border-radius: 4px;
            background: root.fill;
        }
    }
    // The cap: wide, with a centre line across it, the way a mixing-desk fader reads.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: track.height * (1 - root.frac) - self.height / 2;
        width: drag.pressed ? 28px : 26px;
        height: 16px;
        border-radius: 8px;
        background: Theme.card;
        border-width: 2px;
        border-color: drag.pressed ? Theme.text : root.fill;
        animate width, border-color { duration: Theme.quick; easing: Theme.ease-state; }
        Rectangle {
            x: 3px;
            y: (parent.height - 1px) / 2;
            width: parent.width - 6px;
            height: 1px;
            background: root.fill;
        }
    }
    drag := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        property <float> at: 1 - max(0, min(1, (self.mouse-y / 1px) / max(1, self.height / 1px)));
        moved => { root.moved(self.at); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.moved(self.at); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
    }
}

component MiniStep inherits HorizontalLayout {
    in property <string> label;
    in property <string> caption;
    in property <bool> dim: false;
    callback stepped(int);

    spacing: 0;
    height: 22px;
    IconBtn { icon: Icons.remove; sz: 13px; width: 20px; height: 20px; clicked => { root.stepped(-1); } }
    Text {
        text: root.label;
        color: root.dim ? Theme.faint : Theme.sub;
        font-family: Theme.mono;
        font-size: 10px;
        horizontal-stretch: 1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    IconBtn { icon: Icons.add; sz: 13px; width: 20px; height: 20px; clicked => { root.stepped(1); } }
}

component BandCard inherits Rectangle {
    in property <BandRow> band;
    in property <bool> selected;
    callback picked();
    callback muted();
    callback gain-moved(float);
    callback gain-released();
    callback type-cycled(int);
    callback freq-stepped(int);
    callback q-stepped(int);

    border-radius: Theme.r-md;
    border-width: 1px;
    background: root.selected ? Theme.accent-soft : Theme.card;
    border-color: root.selected ? Theme.accent : Theme.line;
    // A muted band stays legible — you have to be able to read what you turned off
    // in order to decide to turn it back on — but stops competing for attention.
    opacity: root.band.enabled ? 1.0 : 0.55;
    animate background, border-color, opacity { duration: Theme.quick; easing: Theme.ease-state; }

    // Click anywhere that is not a control to select the band.
    TouchArea { clicked => { root.picked(); } }

    VerticalLayout {
        padding: 8px;
        spacing: 5px;

        // region tag + the slot the write actually targets — the same number the
        // graph prints on its handle, so the two can never disagree
        HorizontalLayout {
            height: 12px;
            Text {
                text: root.band.region;
                color: root.band.enabled ? Theme.accent : Theme.faint;
                font-family: Theme.mono;
                font-size: 8px;
                font-weight: 700;
                letter-spacing: 0.4px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // The slot number doubles as the band's on/off switch. It is already
            // the thing your eye goes to when you want "that one", and a card this
            // dense has no room for a control that only does one thing.
            Rectangle {
                width: numt.has-hover ? 30px : 14px;
                height: 12px;
                border-radius: 6px;
                background: numt.has-hover ? Theme.accent-soft : transparent;
                animate width, background { duration: Theme.quick; easing: Theme.ease-state; }
                Text {
                    text: numt.has-hover
                        ? (root.band.enabled ? "mute" : "on")
                        : "\{root.band.index + 1}";
                    color: numt.has-hover ? Theme.accent
                        : (root.band.enabled ? Theme.faint : Theme.bad);
                    font-family: Theme.mono;
                    font-size: 8px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                numt := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.muted(); }
                }
            }
        }

        // filter type — click cycles forward, right-click back
        Rectangle {
            height: 24px;
            border-radius: 12px;
            background: root.band.enabled
                ? (typet.has-hover ? Theme.accent-soft : Theme.card-2)
                : Theme.well;
            border-width: 1px;
            border-color: Theme.line-2;
            animate background { duration: Theme.quick; easing: Theme.ease-state; }
            Text {
                text: root.band.abbr;
                color: root.band.enabled ? Theme.text : Theme.faint;
                font-family: Theme.mono;
                font-size: 11px;
                font-weight: 700;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            typet := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.picked();
                        root.type-cycled(e.button == PointerEventButton.right ? -1 : 1);
                    }
                }
            }
        }

        // the tall centrepiece
        Rectangle {
            vertical-stretch: 1;
            VTrack {
                x: (parent.width - self.width) / 2;
                height: parent.height;
                frac: root.band.gain-frac;
                enabled: root.band.enabled;
                fill: !root.band.enabled ? Theme.faint
                    : (root.band.at-limit ? Theme.warn
                    : (root.selected ? Theme.accent : Theme.curve));
                moved(f) => { root.gain-moved(f); }
                released => { root.gain-released(); }
            }
        }

        // gain readout — turns amber and tags "limit" when the band is pinned against
        // the firmware's Q2.30 coefficient ceiling, so the wall is visible instead of
        // just feeling like a stuck slider
        HorizontalLayout {
            height: 16px;
            spacing: 4px;
            alignment: center;
            Text {
                text: root.band.gain-label;
                color: !root.band.enabled ? Theme.faint
                    : (root.band.at-limit ? Theme.warn : Theme.text);
                font-family: Theme.mono;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.band.at-limit: Text {
                text: "limit";
                color: Theme.warn;
                font-family: Theme.mono;
                font-size: 8px;
                vertical-alignment: center;
            }
        }

        MiniStep {
            label: root.band.freq-label;
            dim: !root.band.enabled;
            stepped(d) => { root.freq-stepped(d); }
        }
        Text {
            text: "FREQ";
            color: Theme.faint;
            font-family: Theme.mono;
            font-size: 7px;
            letter-spacing: 1px;
            height: 9px;
            horizontal-alignment: center;
        }
        MiniStep {
            label: root.band.q-label;
            dim: !root.band.enabled;
            stepped(d) => { root.q-stepped(d); }
        }
    }
}

// ── overlays ────────────────────────────────────────────────────────────────────
component SheetHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    // What one step back returns to, empty when that is the editor. A sheet opened
    // from another sheet closes *to* it, and the header should say so before you
    // press the button rather than after.
    in property <string> back-to;
    callback closed();
    height: 30px;
    spacing: 10px;
    if root.back-to != "": VerticalLayout {
        alignment: center;
        IconBtn { icon: Icons.arrow-back; clicked => { root.closed(); } }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        text: root.note;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 10px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    if root.back-to == "": IconBtn { icon: Icons.close; clicked => { root.closed(); } }
}

// One page of the tuning guide. The figures are SVG path commands drawn by the same
// response engine the editor plots with — not illustrations of the maths, the maths.
// A guide about the shape of a filter that contains no shapes was asking the reader to
// picture what the program is already able to draw.
struct GuidePage {
    key: string,
    head: string,
    lede: string,
    body: string,
    // up to three traces on one set of axes, each with a label under it
    fig-a: string,
    fig-b: string,
    fig-c: string,
    key-a: string,
    key-b: string,
    key-c: string,
    // drawn behind the traces when the page is about output level rather than shape
    fig-zero: string,
}

component HelpPara inherits VerticalLayout {
    in property <string> head;
    in property <string> body;
    spacing: 3px;
    Text {
        text: root.head;
        color: Theme.accent;
        font-family: Theme.mono;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }
    Text {
        text: root.body;
        color: Theme.sub;
        font-size: 12px;
        wrap: word-wrap;
    }
}

// ── the welcome screen ──────────────────────────────────────────────────────────
// The mark, animated: a crescent that scales in, with an equaliser reading inside it.
// The bars keep breathing while the screen is up, and stop existing the moment it is
// dismissed — the Timer lives inside the branch, so there is no animation ticking
// behind the app for the rest of the session.
component MoonMark inherits Rectangle {
    in property <bool> shown;
    width: 116px;
    height: 116px;

    property <bool> beat: false;
    // Bar heights as fractions. Two sets, alternated, so the reading moves like an
    // equaliser rather than pulsing as one block.
    property <[float]> a: [0.34, 0.72, 0.46, 0.95, 0.58, 0.80, 0.40];
    property <[float]> b: [0.55, 0.40, 0.86, 0.52, 0.92, 0.44, 0.68];

    // the disc
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.shown ? 108px : 40px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent-soft;
        border-width: 2px;
        border-color: Theme.accent;
        opacity: root.shown ? 1.0 : 0.0;
        animate width, opacity { duration: Theme.settle; easing: Theme.ease-enter; }
    }
    // the crescent: a second disc in the page colour, offset, biting into the first
    Rectangle {
        x: root.shown ? 40px : 58px;
        y: 4px;
        width: 108px;
        height: 108px;
        border-radius: 54px;
        background: Theme.bg;
        opacity: root.shown ? 1.0 : 0.0;
        animate x, opacity { duration: Theme.settle; easing: Theme.ease-enter; }
    }
    // the reading
    for f[i] in root.a: Rectangle {
        property <float> h: root.beat ? root.b[i] : f;
        x: 26px + i * 9px;
        y: 58px - (root.shown ? 26px * self.h : 0px);
        width: 5px;
        height: root.shown ? 26px * self.h : 0px;
        border-radius: 2.5px;
        background: Theme.accent;
        // The stagger is the whole trick: seven bars arriving together is a block,
        // arriving 70 ms apart is a sweep.
        //
        // EXEMPT from the theme's entrance timing on purpose. This is not a reveal — it is a
        // continuous visualiser re-driven by the 760ms timer below, and the numbers are chosen
        // AGAINST that tick: the last bar starts at 6*70=420ms and runs 520ms, finishing past
        // the next update, so the motion never lands. Retimed to the token pair it finished in
        // ~320ms and then held still for the remaining 440ms of the tick, which reads as a pump
        // rather than a sweep. Continuous motion has to outrun its own driver.
        animate height, y { duration: Theme.pulse; delay: i * Theme.pulse-step; easing: Theme.ease-enter; }
    }
    Timer {
        interval: 760ms;
        running: root.shown;
        triggered => { root.beat = !root.beat; }
    }
}

// Shown on every launch, unlike the welcome screen. It is short on purpose: a splash
// that outstays a second and a half stops being a flourish and starts being a wait, so
// this runs 1.75s end to end and a click skips it outright.
//
// One Timer drives the whole thing by walking a stage counter, because three timers to
// sequence three moments is three things that can drift apart.
component Splash inherits Rectangle {
    callback done();
    background: Theme.bg;

    property <int> stage: 0;
    property <bool> shown: root.stage >= 1;
    property <bool> leaving: root.stage >= 2;

    opacity: root.leaving ? 0.0 : 1.0;
    animate opacity { duration: Theme.settle; easing: Theme.ease-state; }

    Timer {
        // stage 0 → 1: one tick after the first paint, so the animations have a state
        // to move FROM. 1 → 2: hold, then fade. 2 → 3: gone.
        interval: root.stage == 0 ? 40ms : (root.stage == 1 ? 1430ms : 280ms);
        running: root.stage < 3;
        triggered => {
            root.stage += 1;
            if (root.stage == 3) { root.done(); }
        }
    }
    TouchArea { clicked => { root.done(); } }

    VerticalLayout {
        alignment: center;
        spacing: 0;
        HorizontalLayout {
            alignment: center;
            MoonMark { shown: root.shown; }
        }
        Text {
            text: "Hub Moon";
            color: Theme.text;
            font-size: 30px;
            font-weight: 700;
            horizontal-alignment: center;
            opacity: root.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.settle; }
        }
        Rectangle { height: 16px; }
        // A line that draws itself. Not a progress bar — it is not measuring anything —
        // but it gives the hold a reason to exist instead of being a still frame.
        HorizontalLayout {
            alignment: center;
            height: 3px;
            Rectangle {
                width: 168px;
                height: 3px;
                border-radius: 2px;
                background: Theme.well;
                opacity: root.shown ? 1.0 : 0.0;
                animate opacity { duration: Theme.settle; }
                Rectangle {
                    x: 0px;
                    width: root.shown ? parent.width : 0px;
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent;
                    animate width { duration: Theme.settle; easing: Theme.ease-bar; }
                }
            }
        }
    }
}

struct DeviceRow {
    pid: string,
    name: string,
    bands: string,
    slot: string,
    pregain: bool,
    tested: bool,
    here: bool,
}

// The supported-device table. It has lived in the readme since 1.0.0 and never in the
// app, which is exactly backwards: the person who needs it is holding a DAC that did
// not come up, and they are looking at this window, not at GitHub.
component DevicesSheet inherits Rectangle {
    // Sheets used to exist between one frame and the next: `if open: Sheet {}` puts
    // the whole panel on screen at once. `init` flips this the moment the element is
    // built, so the opacity binding has something to animate from — an entrance, not a
    // cut. Closing is still immediate: `if` destroys the element, and holding a heavy
    // sheet alive purely to fade it out is a cost paid on every frame it is open.
    property <bool> entered;
    init => { root.entered = true; }
    opacity: root.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.screen; easing: Theme.ease-enter; }

    in property <[DeviceRow]> rows;
    in property <string> note;
    // Empty when a step back lands on the editor; the screen's name when
    // this one was opened from another.
    in property <string> back-to;
    callback closed();

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        SheetHead {
            title: "Supported devices";
            note: "vendor 0x35D8";
            back-to: root.back-to;
            closed => { root.closed(); }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Text {
            text: root.note;
            color: Theme.sub;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
            // Holds the sheet open when the list is empty — see the profiles sheet
            // for what a Flickable's viewport does to a stretching parent otherwise.
            min-height: 120px;
            clip: true;
            Flickable {
                height: 100%;
                viewport-width: self.width;
                viewport-height: max(self.height, list.preferred-height);
                list := VerticalLayout {
                    width: parent.width;
                    spacing: 4px;
                    for d in root.rows: Rectangle {
                        height: 46px;
                        border-radius: Theme.r-sm;
                        background: d.here ? Theme.accent-soft : Theme.card-2;
                        border-width: 1px;
                        border-color: d.here ? Theme.accent : Theme.line;
                        HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 11px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                width: 56px;
                                Text {
                                    text: d.pid;
                                    color: Theme.faint;
                                    font-family: Theme.mono;
                                    font-size: 11px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text {
                                    text: d.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: d.bands + " · " + d.slot
                                        + (d.pregain ? " · pre-gain" : " · no pre-gain");
                                    color: Theme.faint;
                                    font-family: Theme.mono;
                                    font-size: 9.5px;
                                    overflow: elide;
                                }
                            }
                            // Two different facts, and neither may be implied by the
                            // other: "this is the one plugged in" and "this one has
                            // ever been tried on real hardware".
                            VerticalLayout {
                                alignment: center;
                                if d.here: Rectangle {
                                    width: hchip.preferred-width + 16px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: Theme.accent;
                                    hchip := Text {
                                        text: "connected";
                                        color: Theme.accent-ink;
                                        font-family: Theme.mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: tchip.preferred-width + 16px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: d.tested ? Theme.good-soft : Theme.card;
                                    border-width: 1px;
                                    border-color: d.tested ? Theme.good : Theme.line-2;
                                    tchip := Text {
                                        text: d.tested ? "verified" : "untested";
                                        color: d.tested ? Theme.good : Theme.faint;
                                        font-family: Theme.mono;
                                        font-size: 9px;
                                        font-weight: 700;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: "Untested does not mean unsupported — it means nobody here owns one. If yours works, or does not, the About panel writes the report for you.";
            color: Theme.faint;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

component WelcomeCard inherits Rectangle {
    in property <string> icon;
    in property <string> head;
    in property <string> body;
    in property <bool> shown;
    in property <int> rank;

    border-radius: Theme.r-md;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    opacity: root.shown ? 1.0 : 0.0;
    y: root.shown ? 0px : 18px;
    animate opacity, y { duration: Theme.settle; delay: root.rank * Theme.stagger; easing: Theme.ease-enter; }

    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Sym { d: root.icon; sz: 17px; width: 18px; tint: Theme.accent; }
            Text {
                text: root.head;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.body;
            color: Theme.sub;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

component Welcome inherits Rectangle {
    in property <bool> connected;
    in property <string> device-name;
    callback started();
    callback guide();
    callback devices();
    callback tour();

    background: Theme.bg;
    property <bool> shown: false;
    // One tick after the first paint, so the animations have a state to move FROM.
    // Setting it in `init` would just be the starting value, and nothing would move.
    Timer {
        interval: 40ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    VerticalLayout {
        alignment: center;
        spacing: 0;

        HorizontalLayout {
            alignment: center;
            MoonMark { shown: root.shown; }
        }

        Text {
            text: "Hub Moon";
            color: Theme.text;
            font-size: 34px;
            font-weight: 700;
            horizontal-alignment: center;
            opacity: root.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.settle; }
        }
        Text {
            text: "Parametric EQ for your Moondrop DAC — running on the device's own DSP.";
            color: Theme.sub;
            font-size: 13px;
            horizontal-alignment: center;
            opacity: root.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.settle; }
        }

        Rectangle { height: 10px; }

        // What we found, said plainly — this is the first thing anyone actually wants
        // to know, and burying it behind the "get started" button helps nobody.
        HorizontalLayout {
            alignment: center;
            height: 34px;
            Rectangle {
                width: found.preferred-width + 26px;
                border-radius: 17px;
                background: root.connected ? Theme.good-soft : Theme.card-2;
                border-width: 1px;
                border-color: root.connected ? Theme.good : Theme.line-2;
                opacity: root.shown ? 1.0 : 0.0;
                animate opacity { duration: Theme.settle; }
                found := HorizontalLayout {
                    padding-left: 13px;
                    padding-right: 13px;
                    spacing: 8px;
                    Sym {
                        d: root.connected ? Icons.headphones : Icons.usb-off;
                        sz: 15px;
                        width: 15px;
                        tint: root.connected ? Theme.good : Theme.faint;
                    }
                    Text {
                        text: root.connected ? "\{root.device-name} connected"
                                             : "No DAC found — this is a demo curve you can play with";
                        color: root.connected ? Theme.good : Theme.sub;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { height: 22px; }

        // A centred block of *definite* width, with the cards splitting that — not
        // four stretching cards with a max-width, which is what this was and which
        // came out with the row centred somewhere other than the rest of the screen.
        // Giving the container a real number first means the four shares are a
        // division rather than a negotiation, and 1040px is the width four cards
        // wanted anyway.
        HorizontalLayout {
            alignment: center;
            height: 116px;
            cards := Rectangle {
                width: min(1040px, root.width - 32px);
                HorizontalLayout {
                    spacing: 12px;
                    WelcomeCard {
                        horizontal-stretch: 1;
                        shown: root.shown;
                        rank: 0;
                        icon: Icons.show-chart;
                        head: "Drag the graph";
                        body: "Grab a numbered point to move that band. Scroll anywhere on the plot to widen or narrow the one you picked.";
                    }
                    WelcomeCard {
                        horizontal-stretch: 1;
                        shown: root.shown;
                        rank: 1;
                        icon: Icons.tune;
                        head: "Or use the faders";
                        body: "Every band has a card underneath: filter type, a gain fader, and steppers for frequency and Q.";
                    }
                    WelcomeCard {
                        horizontal-stretch: 1;
                        shown: root.shown;
                        rank: 2;
                        icon: Icons.graphic-eq;
                        head: "Watch the dashed line";
                        body: "That is what leaves the DAC once headroom is paid. If the curve would clip, the pre-gain card offers a one-tap match.";
                    }
                    WelcomeCard {
                        horizontal-stretch: 1;
                        shown: root.shown;
                        rank: 3;
                        icon: Icons.save;
                        head: "Nothing is permanent";
                        body: "Edits go straight to the DSP so you hear them as you move. Only save to flash keeps them after you unplug.";
                    }
                }
            }
        }

        Rectangle { height: 26px; }

        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            height: 38px;
            opacity: root.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.settle; }
            // Shown first when nothing is connected, because "is mine one of the
            // ones this works with" is the only question that matters at that point.
            if !root.connected: TextBtn {
                label: "Supported devices";
                icon: Icons.usb-off;
                clicked => { root.devices(); }
            }
            TextBtn {
                label: "Show me around";
                icon: Icons.show-chart;
                clicked => { root.tour(); }
            }
            TextBtn {
                label: "Read the tuning guide";
                icon: Icons.help;
                clicked => { root.guide(); }
            }
            TextBtn {
                label: root.connected ? "Start tuning" : "Try the demo";
                icon: Icons.graphic-eq;
                primary: true;
                clicked => { root.started(); }
            }
        }

        Rectangle { height: 14px; }

        Text {
            text: "You can bring this back any time from the appearance settings.";
            color: Theme.faint;
            font-size: 10px;
            horizontal-alignment: center;
            opacity: root.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.settle; }
        }
    }
}

// A two-option choice. Not a checkbox: "dark mode: off" makes you work out what the
// other state is, where two labelled halves show you both and which one you are on.
// Segmented, for more than two choices: same moving indicator, driven by an index and
// a list of labels rather than a bool and two strings. The labels come from the
// bridge — the order the library can be sorted in is policy, and policy does not live
// in the view.
component Choice inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    callback picked(int);

    property <length> slot: root.options.length > 0
        ? root.width / root.options.length : root.width;

    height: 30px;
    border-radius: 15px;
    background: Theme.card-2;
    border-width: 1px;
    border-color: Theme.line-2;

    Rectangle {
        x: root.index * root.slot;
        width: root.slot;
        height: parent.height;
        border-radius: 15px;
        background: Theme.accent;
        animate x { duration: Theme.settle; easing: Theme.ease-enter; }
    }
    HorizontalLayout {
        for o[i] in root.options: Rectangle {
            Text {
                text: o;
                color: i == root.index ? Theme.accent-ink : Theme.sub;
                font-size: 11.5px;
                font-weight: 600;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

component Segmented inherits Rectangle {
    in property <string> left;
    in property <string> right;
    in property <bool> on-right;
    callback picked(bool);

    height: 32px;
    width: 190px;
    border-radius: 16px;
    background: Theme.card-2;
    border-width: 1px;
    border-color: Theme.line-2;

    // the moving indicator, which is what makes the choice read as one control
    Rectangle {
        x: root.on-right ? parent.width / 2 : 0px;
        y: 0px;
        width: parent.width / 2;
        height: parent.height;
        border-radius: 16px;
        background: Theme.accent;
        animate x { duration: Theme.settle; easing: Theme.ease-enter; }
    }
    HorizontalLayout {
        Rectangle {
            Text {
                text: root.left;
                color: root.on-right ? Theme.sub : Theme.accent-ink;
                font-size: 12px;
                font-weight: 600;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(false); } }
        }
        Rectangle {
            Text {
                text: root.right;
                color: root.on-right ? Theme.accent-ink : Theme.sub;
                font-size: 12px;
                font-weight: 600;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.picked(true); } }
        }
    }
}

// A labelled row: description on the left, its control on the right.
//
// Not a HorizontalLayout, and that is the whole point. A `Text` with `wrap:
// word-wrap` reports its preferred height at its *natural* width — the width it
// would take on one line — so a layout asked to size a row around one is told every
// note is a single line tall. Setting `height` gave overlapping rows; setting
// `min-height` gave exactly the same overlap, because the number being maxed against
// was already wrong.
//
// So the text column is given an explicit width first, which lets it compute the
// height it really needs, and the row is sized from that. Fixing the measurement
// rather than the symptom.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    // Wide enough for the widest control in the column, not a round number with room
    // to spare: every pixel reserved here and not used is a pixel the description has
    // to wrap in, and a two-line note beside a control with 10px of air after it is
    // the wrong trade.
    in property <length> control-width: 190px;

    property <length> gap: 20px;
    // Both sides, not just the text. The row used to be sized by its description
    // alone, on the assumption that a control is one switch tall — which held until
    // the palette picker arrived as a column of four, and promptly overflowed into
    // the row below it. A row is as tall as the taller of the two things in it.
    height: max(66px, col.preferred-height + 20px, ctrl.preferred-height + 20px);

    col := VerticalLayout {
        x: 0px;
        y: (root.height - self.preferred-height) / 2;
        width: root.width - root.control-width - root.gap;
        // Explicit, or it defaults to the full row height and spreads the label and
        // the note to opposite ends of it — invisible while every row was one control
        // tall, obvious the moment the palette picker made one 130px tall.
        height: self.preferred-height;
        spacing: 3px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.note;
            color: Theme.faint;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    Rectangle {
        x: root.width - root.control-width;
        width: root.control-width;
        height: root.height;
        // `alignment: end`, so a control narrower than the column sits flush with the
        // panel edge instead of floating in the middle of its own reservation. That
        // is what lines a 190px switch up with the buttons underneath it, which are
        // right-aligned against the same edge.
        //
        // Named, because the row above reads its preferred height to size itself.
        ctrl := HorizontalLayout {
            alignment: end;
            @children
        }
    }
}

// A row in the settings rail. Not a tab strip across the top: three groups with
// long labels do not fit one, and a vertical rail leaves the panel its full width.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback picked();

    height: 34px;
    border-radius: Theme.r-sm;
    background: root.active ? Theme.accent-soft
        : (nav.has-hover ? Theme.card-2 : transparent);
    animate background { duration: Theme.quick; easing: Theme.ease-state; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Sym {
            d: root.icon;
            sz: 15px;
            width: 15px;
            tint: root.active ? Theme.accent : Theme.sub;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.sub;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    nav := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// A flat progress bar. Not a component library's — this needs exactly one thing, and
// the width of a filled rectangle is exactly that one thing.
component Meter inherits Rectangle {
    in property <float> value;      // 0..1
    height: 5px;
    border-radius: 3px;
    background: Theme.card-2;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.value, 0.0, 1.0);
        height: parent.height;
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: Theme.settle; easing: Theme.ease-state; }
    }
}

// One thing this app does, with the icon it is known by elsewhere in the interface.
// About is the page somebody opens before they trust a program with their hardware, so
// it should say what the program is — not only which version of it broke.
component AboutCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> body;

    height: inner.preferred-height + 20px;
    border-radius: Theme.r-sm;
    background: Theme.card-2;
    border-width: 1px;
    border-color: Theme.line;

    inner := HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            width: 18px;
            Sym { d: root.icon; sz: 16px; tint: Theme.accent; width: 18px; height: 18px; }
        }
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: root.body;
                color: Theme.faint;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
}

component SettingsSheet inherits Rectangle {
    // Sheets used to exist between one frame and the next: `if open: Sheet {}` puts
    // the whole panel on screen at once. `init` flips this the moment the element is
    // built, so the opacity binding has something to animate from — an entrance, not a
    // cut. Closing is still immediate: `if` destroys the element, and holding a heavy
    // sheet alive purely to fade it out is a cost paid on every frame it is open.
    property <bool> entered;
    init => { root.entered = true; }
    opacity: root.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.screen; easing: Theme.ease-enter; }

    in property <bool> dark;
    in property <bool> readout;
    in property <int> accent-index;
    in property <int> skin-index;
    in property <string> settings-path;
    in property <string> app-version;
    in property <string> about-text;
    in property <string> update-state;
    in property <string> update-note;
    in property <string> update-version;
    in property <string> update-hint;
    in property <string> update-command;
    in property <bool> update-can-fetch;
    in property <bool> update-rollback;
    in property <bool> update-can-elevate;
    in property <string> update-reason;
    in property <float> update-progress;
    in property <bool> update-can-install;
    in property <int> update-channel;
    in property <bool> update-auto;
    in property <string> install-note;
    in property <bool> opt-fullscreen;
    in property <bool> opt-watch;
    in property <bool> opt-prefetch;
    in property <bool> opt-history;
    in property <[string]> motion-labels;
    in property <int> opt-motion;
    in property <bool> connected;
    in property <string> device-name;
    in property <string> firmware;
    in property <int> band-count;
    callback switched(string, bool);
    callback set-motion(int);
    callback devices-clicked();
    // Empty when a step back lands on the editor; the screen's name when
    // this one was opened from another.
    in property <string> back-to;
    callback closed();
    callback dark-picked(bool);
    callback readout-picked(bool);
    callback accent-picked(int);
    callback skin-picked(int);
    callback welcome-again();
    callback check-clicked();
    callback install-clicked();
    callback skip-clicked();
    callback channel-picked(int);
    callback auto-picked(bool);
    callback logs-clicked();
    callback notes-clicked();
    callback copy-clicked();
    callback copy-command();
    callback whatsnew-clicked();
    callback preview-notes();
    callback restart-clicked();

    // Opens on whichever group has something to say. A binding, not a constant, so
    // it picks the right starting tab — and the moment the reader clicks the rail
    // that assignment replaces it, and their choice sticks.
    // 3 is Updates. It was 1 until Window and Library were inserted ahead of it, and
    // an index left behind by a reordered rail is a silent bug: the sheet still opens,
    // just on the wrong page, with the update it was summoned to show one click away.
    property <int> tab: root.update-state == "available" || root.update-state == "fetched"
        || root.update-state == "installed" || root.busy ? 3 : 0;
    property <bool> busy: root.update-state == "checking"
        || root.update-state == "downloading" || root.update-state == "staged"
        || root.update-state == "authorising";
    property <bool> has-banner: root.busy || root.update-state == "available"
        || root.update-state == "fetched" || root.update-state == "installed";

    // How wide a paragraph in the panel really is: this sheet, less its own padding
    // (16 twice), the rail (148), the rule (1) and the 14px gap on each side of it —
    // 209 in all.
    //
    // Spelled out because a `Text` that wraps only knows its height once it knows its
    // width, and the panel's width is not resolved at the moment the Flickable asks
    // its content how tall it would like to be. Left implicit, every paragraph
    // measured as one line: the About page's viewport came up some 300px short and
    // the credits at the bottom of it could not be scrolled to at all.
    property <length> prose-w: root.width - 209px;

    // How tall this sheet would like to be, for the parent to clamp — and the same
    // answer whatever tab is showing.
    //
    // It used to be each tab's own content height, on the reasoning that a height
    // fitting the longest tab leaves 400px of nothing under the shortest. That is
    // true, and it is still the better trade: sized per tab, the dialog grew and
    // shrank under the pointer as you moved down the rail, jumping some 300px between
    // Appearance and Window. A settings window that will not hold still while you
    // read it is worse than one with room to spare at the bottom, and the rail is a
    // fixed column down the left — only the panel beside it is supposed to change.
    //
    // `pane` is the scrolling content, so this is exact for it; the chrome around it
    // is a constant (16px padding twice, a 30px head, a rule, two 10px gaps) and the
    // banner an allowance. Being a little out either way costs a little slack or a
    // little scrolling, and the Flickable already handles the second.
    //
    // The floor is not decoration. `pane.preferred-height` is honest for tabs made of
    // rows with fixed heights, and *under-reports* for one made mostly of wrapping
    // prose: a `Text` with `wrap: word-wrap` reports the height it would take at its
    // natural width — one line — so About measured about a third of what it draws and
    // the sheet closed over its own last paragraph. Fixing the measurement properly
    // means giving every paragraph an explicit width first, which is what SettingRow
    // had to do; About is a column of eight of them, and a floor is the honest cheap
    // answer. It scrolls if it is still short.
    // A constant, not a maximum over the tabs. `max(content, floor)` still grew for
    // any tab whose content passed the floor — About did — so the sheet was steady
    // across four tabs and jumped on the fifth, which is the same complaint with one
    // fewer symptom. The panel scrolls; the dialog does not resize.
    out property <length> wanted: 620px + 83px + (root.has-banner ? 112px : 0px);

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        SheetHead {
            title: "Settings";
            note: root.tab == 4 ? "Hub Moon " + root.app-version : root.settings-path;
            back-to: root.back-to;
            closed => { root.closed(); }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // A waiting update is pinned above everything, on every tab. Most people open
        // this sheet to change the theme, and something that needs a decision must not
        // be two clicks and a scroll away.
        if root.has-banner: Rectangle {
            height: banner.preferred-height + 20px;
            border-radius: Theme.r-sm;
            background: Theme.accent-soft;
            banner := HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: root.update-state == "available"
                            ? (root.update-rollback
                               ? "Return to stable — Hub Moon " + root.update-version
                               : "Hub Moon " + root.update-version + " is available")
                            : root.update-state == "staged" ? "Update ready"
                            : root.update-state == "downloading" ? "Downloading update"
                            : root.update-state == "fetched" ? "Downloaded — one command to go"
                            : root.update-state == "authorising" ? "Waiting for permission"
                            : root.update-state == "installed" ? "Installed — restart to use it"
                            : "Checking for updates";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.update-note;
                        color: Theme.sub;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    if root.update-state == "downloading" || root.update-state == "staged":
                        Meter { value: root.update-progress; }
                }
                // `can-fetch` belongs here too. Without it a machine that can download
                // the package but has no polkit agent to install it with got no button
                // at all — and no explanation either, because the box that explains a
                // missing button only appears when there is nothing to download.
                if root.update-state == "available"
                        && (root.update-can-install || root.update-can-elevate
                            || root.update-can-fetch):
                    VerticalLayout {
                        alignment: center;
                        TextBtn {
                            label: root.update-rollback ? "Go back"
                                : (root.update-can-install || root.update-can-elevate)
                                ? "Install" : "Download";
                            icon: Icons.download;
                            primary: true;
                            clicked => { root.install-clicked(); }
                        }
                    }
                if root.update-state == "installed": VerticalLayout {
                    alignment: center;
                    TextBtn {
                        label: "Restart now";
                        icon: Icons.restart-alt;
                        primary: true;
                        clicked => { root.restart-clicked(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            // ── the rail ──
            VerticalLayout {
                width: 148px;
                spacing: 4px;
                NavItem {
                    label: "Appearance";
                    icon: Icons.tune;
                    active: root.tab == 0;
                    picked => { root.tab = 0; }
                }
                NavItem {
                    label: "Window";
                    icon: Icons.home;
                    active: root.tab == 1;
                    picked => { root.tab = 1; }
                }
                NavItem {
                    label: "Library";
                    icon: Icons.groups;
                    active: root.tab == 2;
                    picked => { root.tab = 2; }
                }
                NavItem {
                    label: "Updates";
                    icon: Icons.download;
                    active: root.tab == 3;
                    picked => { root.tab = 3; }
                }
                NavItem {
                    label: "About";
                    icon: Icons.info;
                    active: root.tab == 4;
                    picked => { root.tab = 4; }
                }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle { width: 1px; background: Theme.line; }

            // ── the panel ──
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Flickable {
                    viewport-height: pane.preferred-height;
                    pane := VerticalLayout {
                        width: parent.width;
                        spacing: 8px;

                        if root.tab == 0: VerticalLayout {
                            spacing: 8px;
                                    SettingRow {
                                        label: "Theme";
                                        note: "Dark is re-picked rather than inverted — same rose, chosen twice.";
                                        VerticalLayout {
                                            alignment: center;
                                            Segmented {
                                                left: "Light";
                                                right: "Dark";
                                                on-right: root.dark;
                                                picked(v) => { root.dark-picked(v); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Palette";
                                        // Four named grounds need names — a row of
                                        // grey swatches is unreadable in a way a row
                                        // of hues is not, because the thing that
                                        // distinguishes them is the thing a 30px
                                        // circle is worst at showing.
                                        control-width: 220px;
                                        note: "The surfaces and the ink, which is nearly the whole screen. Independent of the accent — any hue sits on any of these.";
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 5px;
                                            for pal[i] in Skins.all: Rectangle {
                                                height: 26px;
                                                border-radius: Theme.r-sm;
                                                background: i == root.skin-index
                                                    ? Theme.accent-soft
                                                    : (skt.has-hover ? Theme.card-2 : transparent);
                                                border-width: 1px;
                                                border-color: i == root.skin-index
                                                    ? Theme.accent : transparent;
                                                animate background { duration: Theme.quick; easing: Theme.ease-state; }
                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 9px;
                                                    spacing: 7px;
                                                    // A two-tone chip: the ground and
                                                    // a card on it, which is the
                                                    // difference you actually see.
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 26px;
                                                            height: 14px;
                                                            border-radius: 4px;
                                                            background: Theme.dark ? pal.bg-d : pal.bg;
                                                            border-width: 1px;
                                                            border-color: Theme.dark ? pal.line-2-d : pal.line-2;
                                                            Rectangle {
                                                                x: 12px;
                                                                y: 3px;
                                                                width: 11px;
                                                                height: 8px;
                                                                border-radius: 2px;
                                                                background: Theme.dark ? pal.card-d : pal.card;
                                                            }
                                                        }
                                                    }
                                                    Text {
                                                        text: pal.name;
                                                        color: i == root.skin-index ? Theme.accent : Theme.text;
                                                        font-size: 11.5px;
                                                        font-weight: i == root.skin-index ? 700 : 500;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                }
                                                skt := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.skin-picked(i); }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Accent";
                                        // six 30px swatches with five 8px gaps, which
                                        // is 220px exactly — wider than the default
                                        // column, which clipped the last one off
                                        control-width: 220px;
                                        note: "One hue, used for the primary action, the active state and the equalised curve. The reference and output traces stay put — those are learned colours.";
                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                height: 30px;
                                                for a[i] in Accents.all: Rectangle {
                                                    width: 30px;
                                                    border-radius: 15px;
                                                    background: Theme.dark ? a.base-d : a.base;
                                                    border-width: sw.has-hover || i == root.accent-index ? 3px : 0px;
                                                    border-color: Theme.text;
                                                    animate border-width { duration: Theme.quick; easing: Theme.ease-state; }
                                                    // The tick is on the swatch rather than beside it: a ring alone
                                                    // reads as hover, and hover and selected must not look the same.
                                                    Sym {
                                                        d: i == root.accent-index ? Icons.check : "";
                                                        sz: 15px;
                                                        tint: Theme.dark ? a.ink-d : a.ink;
                                                        width: 100%;
                                                        height: 100%;
                                                    }
                                                    sw := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.accent-picked(i); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Graph";
                                        note: "Editor draws each band and lets you drag it. Readout draws the level that leaves the DAC, normalised to a 60 dB reference.";
                                        VerticalLayout {
                                            alignment: center;
                                            Segmented {
                                                left: "Editor";
                                                right: "Readout";
                                                on-right: root.readout;
                                                picked(v) => { root.readout-picked(v); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Motion";
                                        note: "How much the interface animates. Off is genuinely off — every duration becomes zero — and nothing about what the app does depends on an animation finishing.";
                                        control-width: 220px;
                                        VerticalLayout {
                                            alignment: center;
                                            Choice {
                                                // Explicit: a Choice is built from
                                                // stretching children and has no width
                                                // of its own, so in a centred column it
                                                // collapses to nothing and prints its
                                                // three labels on top of each other.
                                                width: 220px;
                                                options: root.motion-labels;
                                                index: root.opt-motion;
                                                picked(i) => { root.set-motion(i); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Welcome screen";
                                        note: "The opening screen, with what each control does. Shown once on a first run.";
                                        VerticalLayout {
                                            alignment: center;
                                            TextBtn {
                                                label: "Show it again";
                                                icon: Icons.restart-alt;
                                                clicked => { root.welcome-again(); }
                                            }
                                        }
                                    }
                            Text {
                                text: "The graph also has a toggle of its own, at its top-right corner.";
                                color: Theme.faint;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        // ── Window ──
                        if root.tab == 1: VerticalLayout {
                            spacing: 8px;
                            SettingRow {
                                label: "Open fullscreen";
                                note: "Take the whole screen on launch. On a tiling compositor the window already fills its tile without this — fullscreen additionally covers the bar. Applies from the next start.";
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        left: "Off";
                                        right: "On";
                                        on-right: root.opt-fullscreen;
                                        picked(v) => { root.switched("start_fullscreen", v); }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            SettingRow {
                                label: "Watch for devices";
                                note: "Notice a DAC being plugged in or pulled out without being asked. One enumeration every two seconds; it never opens the device and never interrupts an edit.";
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        left: "Off";
                                        right: "On";
                                        on-right: root.opt-watch;
                                        picked(v) => { root.switched("watch_devices", v); }
                                    }
                                }
                            }
                        }

                        // ── Library ──
                        if root.tab == 2: VerticalLayout {
                            spacing: 8px;
                            SettingRow {
                                label: "Fetch curves";
                                note: "Read each config's curve so the community list can draw it and say what shape it is. A few hundred bytes each, cached permanently. Off leaves the list working from titles alone.";
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        left: "Off";
                                        right: "On";
                                        on-right: root.opt-prefetch;
                                        picked(v) => { root.switched("hub_prefetch", v); }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            SettingRow {
                                label: "Recent list";
                                note: "Keep a note of what you apply, so you can put it back. Twenty entries, on this computer only. Turning it off stops recording — it does not erase what is already there.";
                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        left: "Off";
                                        right: "On";
                                        on-right: root.opt-history;
                                        picked(v) => { root.switched("keep_history", v); }
                                    }
                                }
                            }
                        }

                        if root.tab == 3: VerticalLayout {
                            spacing: 8px;
                                    SettingRow {
                                        label: "Check for updates";
                                        note: root.install-note;
                                        VerticalLayout {
                                            alignment: center;
                                            Segmented {
                                                left: "Off";
                                                right: "On";
                                                on-right: root.update-auto;
                                                picked(v) => { root.auto-picked(v); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    SettingRow {
                                        label: "Channel";
                                        note: "Stable is the tagged release. Beta is what is being tested next — newer, and the reason the changelog has an \"unreleased\" section.";
                                        VerticalLayout {
                                            alignment: center;
                                            Segmented {
                                                left: "Stable";
                                                right: "Beta";
                                                on-right: root.update-channel == 1;
                                                picked(v) => { root.channel-picked(v ? 1 : 0); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }

                                    // The status block. One row, and what it offers depends entirely on where the
                                    // check got to — there is no state in which every button is meaningful, so
                                    // none of them are shown greyed out waiting to become so.
                                    VerticalLayout {
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                spacing: 3px;
                                                Text {
                                                    // What is running, and only that.
                                                    // Announcing the offer here as well
                                                    // said the same sentence twice, 250px
                                                    // apart — and said it *differently*
                                                    // on a rollback, where the banner read
                                                    // "Return to stable" and this read
                                                    // "1.1.0 is available". The banner is
                                                    // pinned above every tab; it does not
                                                    // need repeating on this one.
                                                    text: "You are running Hub Moon " + root.app-version;
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.update-note == ""
                                                        ? "Nothing has been checked yet this session."
                                                        : root.update-note;
                                                    color: Theme.faint;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                TextBtn {
                                                    label: root.update-state == "checking" ? "Checking…" : "Check now";
                                                    icon: Icons.refresh;
                                                    enabled: !root.busy;
                                                    clicked => { root.check-clicked(); }
                                                }
                                            }
                                        }

                                        if root.update-state == "downloading" || root.update-state == "staged":
                                            Meter { value: root.update-progress; }

                                        if root.update-state == "available": HorizontalLayout {
                                            spacing: 8px;
                                            // No install button here: it is in the banner
                                            // above, which is pinned to every tab. Three
                                            // copies of one action in one panel is not
                                            // three chances to find it.
                                            //
                                            // In-app and offline, unlike the website
                                            // link this replaced: the notes are in the
                                            // manifest the check just read, and a
                                            // build with no published release behind
                                            // it falls back to the ones compiled in.
                                            TextBtn {
                                                label: "What's new";
                                                icon: Icons.note;
                                                clicked => { root.preview-notes(); }
                                            }
                                            TextBtn {
                                                label: "Skip this one";
                                                icon: Icons.close;
                                                clicked => { root.skip-clicked(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        // After a package has been fetched: the exact line to run, path and all.
            if root.update-state == "fetched": Rectangle {
                height: donebox.preferred-height + 18px;
                border-radius: Theme.r-sm;
                background: Theme.card-2;
                border-width: 1px;
                border-color: Theme.accent-line;
                donebox := VerticalLayout {
                    padding: 9px;
                    spacing: 6px;
                    Text {
                        text: "Downloaded and checked. Installing it needs root, so this is yours to run:";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.update-command;
                        color: Theme.text;
                        font-family: Theme.mono;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        TextBtn {
                            label: "Copy command";
                            icon: Icons.upload-file;
                            primary: true;
                            clicked => { root.copy-command(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            if root.update-state == "available" && !root.update-can-install
                    && !root.update-can-fetch: Rectangle {
                                            height: cmd.preferred-height + 18px;
                                            border-radius: Theme.r-sm;
                                            background: Theme.card-2;
                                            border-width: 1px;
                                            border-color: Theme.line-2;
                                            cmd := VerticalLayout {
                                                padding: 9px;
                                                spacing: 3px;
                                                Text {
                                                    text: root.update-reason;
                                                    color: Theme.faint;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: root.update-hint;
                                                    color: Theme.text;
                                                    font-size: 12px;
                                                    font-family: "monospace";
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                        }

                        if root.tab == 4: VerticalLayout {
                            spacing: 10px;

                            // The identity, at the size an identity is read at. The
                            // mark is the app's own — the one thing on this page that
                            // may carry a logo, since neither MOONDROP's nor AutoEQ's
                            // is ours to ship.
                            HorizontalLayout {
                                spacing: 14px;
                                height: 60px;
                                VerticalLayout {
                                    alignment: center;
                                    Mark { size: 52px; behind: Theme.card; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Hub Moon";
                                        color: Theme.text;
                                        font-size: 24px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Parametric EQ for Moondrop USB DACs";
                                        color: Theme.sub;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 24px;
                                        width: vtxt.preferred-width + 20px;
                                        border-radius: 12px;
                                        background: Theme.accent-soft;
                                        border-width: 1px;
                                        border-color: Theme.accent-line;
                                        vtxt := Text {
                                            text: root.app-version;
                                            color: Theme.accent;
                                            font-family: Theme.mono;
                                            font-size: 11px;
                                            font-weight: 700;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            AboutCard {
                                icon: Icons.graphic-eq;
                                title: "Eight bands, on the DAC's own DSP";
                                body: "The curve runs on the device at 96 kHz, so it applies to everything the computer plays and to nothing the computer has to do. Saved to flash, it survives being unplugged.";
                            }
                            AboutCard {
                                icon: Icons.groups;
                                title: "The community library";
                                body: "Moondrop's own published configs, read-only, filtered by what each curve actually does and drawn on the card before you apply it.";
                            }
                            AboutCard {
                                icon: Icons.headphones;
                                title: "Headphone corrections";
                                body: "AutoEQ's measured targets, fitted to this device's eight bands, with the pre-gain its curve asks for.";
                            }

                            Rectangle { height: 1px; background: Theme.line; }

                            // What is plugged in, in the place people look for it.
                            HorizontalLayout {
                                spacing: 8px;
                                height: 32px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.connected
                                            ? root.device-name + " · firmware " + root.firmware + " · " + root.band-count + " bands"
                                            : "No DAC connected";
                                        color: root.connected ? Theme.text : Theme.faint;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                TextBtn {
                                    label: "Supported devices";
                                    icon: Icons.usb-off;
                                    clicked => { root.devices-clicked(); }
                                }
                            }

                            Text {
                                text: root.install-note;
                                color: Theme.faint;
                                font-size: 11px;
                                width: root.prose-w;
                                wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: Theme.line; }
                            Text {
                                text: "Report a problem";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Eleven of the twelve supported DACs, and all of USB HID on Windows, have never been exercised on hardware anybody here owns. If yours works — or does not — this is the report.";
                                color: Theme.faint;
                                font-size: 11px;
                                width: root.prose-w;
                                wrap: word-wrap;
                            }

                            // The block that goes into a bug report: the facts
                            // somebody would otherwise be asked for, on screen, in one
                            // selectable lump, behind one button.
                            Rectangle {
                                height: sysbox.preferred-height + 20px;
                                border-radius: Theme.r-sm;
                                background: Theme.card-2;
                                border-width: 1px;
                                border-color: Theme.line-2;
                                sysbox := VerticalLayout {
                                    padding: 10px;
                                    Text {
                                        text: root.about-text;
                                        color: Theme.sub;
                                        font-family: Theme.mono;
                                        font-size: 11px;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TextBtn {
                                    label: "What's new";
                                    icon: Icons.info;
                                    clicked => { root.whatsnew-clicked(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TextBtn {
                                    label: "Copy system info";
                                    icon: Icons.upload-file;
                                    primary: true;
                                    clicked => { root.copy-clicked(); }
                                }
                                TextBtn {
                                    label: "Open log folder";
                                    icon: Icons.note;
                                    clicked => { root.logs-clicked(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: "Every session writes to that log, including anything that goes wrong on a worker thread. If you are reporting a bug, it is the file to attach.";
                                color: Theme.faint;
                                font-size: 11px;
                                width: root.prose-w;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            Text {
                                text: "Credits and licence";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Hub Moon is MIT licensed, and is not affiliated with MOONDROP in any way — the community library is Moondrop's own and is read only here. Headphone corrections come from AutoEQ by Jaakko Pasanen (MIT), measured by the people credited on each row. The interface is built with Slint.";
                                color: Theme.faint;
                                font-size: 11px;
                                width: root.prose-w;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
    }
}
// The figure: three traces on shared axes, with a zero line and a small legend.
// Sized by the caller, because the sheet knows how much room it has and this does not.
component GuideFig inherits Rectangle {
    in property <GuidePage> page;
    in property <length> fig-h: 118px;

    height: root.fig-h + (legend.preferred-height + 8px);
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: root.fig-h;
            border-radius: Theme.r-sm;
            background: Theme.card-2;
            border-width: 1px;
            border-color: Theme.line;
            clip: true;

            // 0 dB. Drawn first so every trace reads as a departure from it.
            Path {
                commands: root.page.fig-zero;
                stroke: Theme.line-2;
                stroke-width: 1px;
                // FIG_W / FIG_H in gui/guide.py. Not the element size: the paths are
                // sampled once at a fixed box, and a viewbox of the element's pixels
                // draws them 1:1 so they stop short of its right edge. Stretching the
                // x axis is harmless here — it is log frequency either way.
                viewbox-width: 360;
                viewbox-height: 118;
            }
            // Third and second traces sit under the first: the first is the point
            // being made and the others are what it is being compared against.
            Path {
                commands: root.page.fig-c;
                stroke: Theme.faint;
                stroke-width: 1.5px;
                // FIG_W / FIG_H in gui/guide.py. Not the element size: the paths are
                // sampled once at a fixed box, and a viewbox of the element's pixels
                // draws them 1:1 so they stop short of its right edge. Stretching the
                // x axis is harmless here — it is log frequency either way.
                viewbox-width: 360;
                viewbox-height: 118;
            }
            Path {
                commands: root.page.fig-b;
                stroke: Theme.sub;
                stroke-width: 1.5px;
                // FIG_W / FIG_H in gui/guide.py. Not the element size: the paths are
                // sampled once at a fixed box, and a viewbox of the element's pixels
                // draws them 1:1 so they stop short of its right edge. Stretching the
                // x axis is harmless here — it is log frequency either way.
                viewbox-width: 360;
                viewbox-height: 118;
            }
            Path {
                commands: root.page.fig-a;
                stroke: Theme.accent;
                stroke-width: 2px;
                // FIG_W / FIG_H in gui/guide.py. Not the element size: the paths are
                // sampled once at a fixed box, and a viewbox of the element's pixels
                // draws them 1:1 so they stop short of its right edge. Stretching the
                // x axis is harmless here — it is log frequency either way.
                viewbox-width: 360;
                viewbox-height: 118;
            }
        }
        legend := HorizontalLayout {
            spacing: 14px;
            alignment: start;
            if root.page.key-a != "": HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 14px; height: 2px; y: 6px; background: Theme.accent; }
                Text {
                    text: root.page.key-a;
                    color: Theme.sub;
                    font-family: Theme.mono;
                    font-size: 10px;
                }
            }
            if root.page.key-b != "": HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 14px; height: 2px; y: 6px; background: Theme.sub; }
                Text {
                    text: root.page.key-b;
                    color: Theme.sub;
                    font-family: Theme.mono;
                    font-size: 10px;
                }
            }
            if root.page.key-c != "": HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 14px; height: 2px; y: 6px; background: Theme.faint; }
                Text {
                    text: root.page.key-c;
                    color: Theme.sub;
                    font-family: Theme.mono;
                    font-size: 10px;
                }
            }
        }
    }
}

component HelpSheet inherits Rectangle {
    // Sheets used to exist between one frame and the next: `if open: Sheet {}` puts
    // the whole panel on screen at once. `init` flips this the moment the element is
    // built, so the opacity binding has something to animate from — an entrance, not a
    // cut. Closing is still immediate: `if` destroys the element, and holding a heavy
    // sheet alive purely to fade it out is a cost paid on every frame it is open.
    property <bool> entered;
    init => { root.entered = true; }
    opacity: root.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.screen; easing: Theme.ease-enter; }

    in property <[GuidePage]> pages;
    // Empty when a step back lands on the editor; the screen's name when
    // this one was opened from another.
    in property <string> back-to;
    callback closed();

    // Same treatment as Settings: the pages are very different lengths — one is a
    // paragraph, one is three figures — and a height that fits the longest leaves the
    // shortest sitting in a column of nothing.
    out property <length> wanted: page.preferred-height + 78px;
    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    // A rail and a page, not one long scroll. Seven topics of prose in a column is a
    // thing you skim once and never come back to; a rail is a thing you return to for
    // the one you half-remember.
    property <int> at: 0;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        SheetHead {
            title: "How to tune";
            note: "nothing here is permanent until you save to flash";
            back-to: root.back-to;
            closed => { root.closed(); }
        }
        Rectangle { height: 1px; background: Theme.line; }

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;

            VerticalLayout {
                width: 176px;
                spacing: 3px;
                for p[i] in root.pages: NavItem {
                    label: p.head;
                    icon: Icons.note;
                    active: root.at == i;
                    picked => { root.at = i; }
                }
                Rectangle { vertical-stretch: 1; }
            }
            Rectangle { width: 1px; background: Theme.line; }

            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Flickable {
                    viewport-width: self.width;
                    viewport-height: page.preferred-height;
                    page := VerticalLayout {
                        width: parent.width;
                        spacing: 12px;
                        pg := VerticalLayout {
                            spacing: 12px;
                            property <GuidePage> p: root.pages[root.at];
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: pg.p.head;
                                    color: Theme.accent;
                                    font-family: Theme.mono;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    letter-spacing: 1.4px;
                                }
                                Text {
                                    text: pg.p.lede;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                            }
                            if pg.p.fig-a != "": GuideFig { page: pg.p; }
                            Text {
                                text: pg.p.body;
                                color: Theme.sub;
                                font-size: 12.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

component HubCard inherits Rectangle {
    in property <HubRow> entry;
    callback applied();
    height: 66px;
    border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.accent-soft : Theme.card-2;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent-line : Theme.line;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.applied(); } }

    // The curve itself, drawn small on the right. The point of the whole prefetch:
    // a shelf of shapes can be browsed at a glance in a way a shelf of titles called
    // "V2 final" cannot. Absent until its chunk lands, and nothing shifts when it
    // does — the space is reserved either way.
    Rectangle {
        x: parent.width - 124px;
        y: (parent.height - 30px) / 2;
        width: 108px;
        height: 30px;
        // The path is clamped a few pixels past the box by design, so the card clips
        // rather than letting a +12 dB shelf draw over the title.
        clip: true;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 108;
            viewbox-height: 30;
            commands: root.entry.curve;
            stroke: Theme.accent;
            stroke-width: 1.5px;
        }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 132px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            height: 17px;
            Text {
                text: root.entry.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Sym { d: Icons.favorite; sz: 12px; tint: Theme.faint; width: 12px; }
            Text {
                text: "\{root.entry.likes}";
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 10px;
                vertical-alignment: center;
            }
            Sym { d: Icons.download; sz: 12px; tint: Theme.faint; width: 12px; }
            Text {
                text: "\{root.entry.downloads}";
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 7px;
            height: 12px;
            Text {
                text: "by \{root.entry.author}";
                color: Theme.accent;
                font-family: Theme.mono;
                font-size: 9px;
                vertical-alignment: center;
            }
            if root.entry.shape != "": Text {
                text: root.entry.shape;
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 9px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.entry.desc;
            color: Theme.sub;
            font-size: 11px;
            overflow: elide;
            height: 15px;
        }
    }
}

// A response chart with nothing to grab: regions, grid, flat line, curve. The editor
// graph could be reused with its handles hidden, but a preview that carries a touch
// surface and drag machinery it never uses is a preview you can accidentally edit.
component MiniGraph inherits Rectangle {
    in property <string> curve-path;
    in property <string> flat-path;

    // Fixed viewbox, matching PREVIEW_W/PREVIEW_H in bridge.py. The path is drawn once
    // in that space and stretched here, so this chart can be any size without asking
    // Python for anything.
    property <float> vb-w: 1000;
    property <float> vb-h: 600;

    background: Theme.card-2;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.line;
    clip: true;

    property <length> gutter-l: 30px;
    property <length> gutter-b: 16px;
    property <length> gutter-t: 8px;
    property <length> plot-w: self.width - root.gutter-l - 8px;
    property <length> plot-h: self.height - root.gutter-t - root.gutter-b;

    for r in Regions.all: Rectangle {
        x: root.gutter-l + root.plot-w * r.at;
        y: root.gutter-t;
        width: root.plot-w * (r.to - r.at);
        height: root.plot-h;
        background: Theme.dark ? r.tint-dark : r.tint;
    }

    property <[{at: float, label: string}]> marks: [
        { at: 0.0,  label: "+12" },
        { at: 0.25, label: "+6"  },
        { at: 0.5,  label: "0"   },
        { at: 0.75, label: "-6"  },
        { at: 1.0,  label: "-12" },
    ];
    for m in root.marks: Rectangle {
        x: root.gutter-l;
        y: root.gutter-t + root.plot-h * m.at;
        width: root.plot-w;
        height: 1px;
        background: m.at == 0.5 ? Theme.line-2 : Theme.line;
        opacity: m.at == 0.5 ? 0.9 : 0.5;
    }
    for m in root.marks: Text {
        x: 0px;
        y: root.gutter-t + root.plot-h * m.at - 6px;
        width: root.gutter-l - 5px;
        height: 12px;
        text: m.label;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 8px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    property <[{at: float, label: string}]> fm: [
        { at: 0.0,     label: "20" },
        { at: 0.23300, label: "100" },
        { at: 0.46598, label: "500" },
        { at: 0.56600, label: "1k" },
        { at: 0.79930, label: "5k" },
        { at: 1.0,     label: "20k" },
    ];
    for m in root.fm: Rectangle {
        x: root.gutter-l + root.plot-w * m.at;
        y: root.gutter-t;
        width: 1px;
        height: root.plot-h;
        background: Theme.line;
        opacity: 0.4;
    }
    for m in root.fm: Text {
        x: min(root.gutter-l + root.plot-w - 26px,
               max(root.gutter-l, root.gutter-l + root.plot-w * m.at - 13px));
        y: root.gutter-t + root.plot-h + 1px;
        width: 26px;
        text: m.label;
        color: Theme.faint;
        font-family: Theme.mono;
        font-size: 8px;
        horizontal-alignment: center;
    }

    Path {
        x: root.gutter-l; y: root.gutter-t;
        width: root.plot-w; height: root.plot-h;
        viewbox-width: root.vb-w;
        viewbox-height: root.vb-h;
        commands: root.flat-path;
        stroke: Theme.flat;
        stroke-width: 1.2px;
    }
    Path {
        x: root.gutter-l; y: root.gutter-t;
        width: root.plot-w; height: root.plot-h;
        viewbox-width: root.vb-w;
        viewbox-height: root.vb-h;
        commands: root.curve-path;
        stroke: Theme.curve;
        stroke-width: 2.2px;
    }
}

component PreviewDialog inherits Rectangle {
    in property <string> title-text;
    in property <string> author;
    in property <string> desc;
    in property <string> note;
    in property <string> curve-path;
    in property <string> flat-path;
    callback applied();
    callback closed();

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            height: 34px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.title-text;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.author == "" ? "" : "by \{root.author}";
                    color: Theme.accent;
                    font-family: Theme.mono;
                    font-size: 10px;
                }
            }
            IconBtn { icon: Icons.close; clicked => { root.closed(); } }
        }

        MiniGraph {
            vertical-stretch: 1;
            curve-path: root.curve-path;
            flat-path: root.flat-path;
        }

        Text {
            text: root.note;
            color: Theme.sub;
            font-family: Theme.mono;
            font-size: 10px;
            height: 14px;
        }
        Text {
            text: root.desc;
            color: Theme.faint;
            font-size: 11px;
            height: 30px;
            wrap: word-wrap;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Text {
                text: "Applying overwrites every band. Nothing reaches flash until you save.";
                color: Theme.faint;
                font-size: 10px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            TextBtn { label: "Cancel"; clicked => { root.closed(); } }
            TextBtn {
                label: "Apply this curve";
                icon: Icons.check;
                primary: true;
                clicked => { root.applied(); }
            }
        }
    }
}

// One shape filter. Clicking the active one clears the filter, so the control that
// set it is also the one that undoes it.
component ShapeChip inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> active;
    callback picked();

    height: 24px;
    width: name.preferred-width + 26px;
    border-radius: 12px;
    background: root.active ? Theme.accent
        : (hover.has-hover ? Theme.accent-soft : Theme.card-2);
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.line-2;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }

    name := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        Text {
            text: root.label;
            color: root.active ? Theme.accent-ink : Theme.sub;
            font-size: 10.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: "\{root.count}";
            color: root.active ? Theme.accent-ink : Theme.faint;
            font-family: Theme.mono;
            font-size: 9px;
            vertical-alignment: center;
        }
    }
    hover := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// A list that only builds the rows you can see.
//
// The library's card lists are a `for` inside a Flickable, which instantiates every
// row: 400 community cards at roughly fifteen elements each is six thousand elements
// laid out on every frame, and nine of them fit on screen. Measured with
// `SLINT_DEBUG_PERFORMANCE=refresh_full_speed`: **116 fps** with an empty list, **80**
// with forty cards, **54** with four hundred. The cards cost that whether or not
// anyone can see them.
//
// Slint's own `ListView` does this properly, but it lives in `std-widgets` and this
// interface deliberately imports none of it. So the row *slots* are still real — a
// bare Rectangle each, which is cheap — and the card inside a slot is built only when
// the slot is near the viewport. `PITCH` is the row height plus the gap, which is what
// makes an absolute `y` possible and the viewport height exact rather than measured.
//
// The margin is a whole viewport in each direction, so a card is always built before
// it can be scrolled into view and a fast flick cannot outrun it.
component LazyRows inherits Rectangle {
    in property <length> pitch;
    in property <length> row-height;
    // Taken from the model's own length, never from a count carried alongside it: the
    // scroll extent is arithmetic on this, so the two disagreeing would mean a list you
    // cannot reach the bottom of.
    in property <int> count;
    // What the slot at `index` should draw. The caller fills this in — the point of
    // this component is the windowing, not the row.
    callback slot(int);

    property <length> top: -flick.viewport-y - flick.height;
    property <length> bottom: -flick.viewport-y + 2 * flick.height;

    public pure function shown(i: int) -> bool {
        return i * root.pitch + root.row-height > root.top && i * root.pitch < root.bottom;
    }

    flick := Flickable {
        height: 100%;
        // Exact rather than measured: every row is the same height, so there is no
        // reason to lay out four hundred of them to find out how tall the list is.
        viewport-height: max(self.height, root.count * root.pitch);
        @children
    }
}

// One tab of the library. A count rather than a bare name: the difference between
// "Saved" and "Saved 12" is the difference between a place you might go and a place
// you know has something in it.


// One line of a release's notes. Its own component so the entrance can be staggered
// by rank, the same way the welcome cards are.
component NoteLine inherits Rectangle {
    in property <string> body;
    in property <int> rank;
    in property <bool> shown;

    height: line.preferred-height + 16px;
    border-radius: Theme.r-sm;
    background: hover.has-hover ? Theme.card-2 : transparent;
    animate background { duration: Theme.quick; easing: Theme.ease-state; }
    opacity: root.shown ? 1.0 : 0.0;
    x: root.shown ? 0px : 14px;
    animate opacity, x { duration: Theme.settle; delay: root.rank * Theme.stagger; easing: Theme.ease-enter; }

    hover := TouchArea { }
    line := HorizontalLayout {
        padding: 8px;
        spacing: 11px;
        // A numbered chip rather than a bullet: it gives the eye a column to run down
        // and makes four changes read as a list of four things rather than a paragraph.
        VerticalLayout {
            alignment: start;
            width: 21px;
            Rectangle {
            width: 21px;
            height: 21px;
            border-radius: 6px;
            background: Theme.accent-soft;
            Text {
                text: root.rank + 1;
                color: Theme.accent;
                font-family: Theme.mono;
                font-size: 11px;
                font-weight: 700;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            }
        }
        Text {
            text: root.body;
            color: Theme.sub;
            font-size: 12.5px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// Shown once, the first time a new version runs — and only when there was a previous
// one to have changed from. On a fresh install the welcome screen does this job.
component WhatsNew inherits Rectangle {
    in property <string> version;
    in property <string> from-version;
    in property <[string]> notes;
    // The same panel, before and after. `preview` is a version that is being offered
    // rather than one that is running, and every sentence in here that says "installed"
    // would be false in that state — so each of them asks.
    in property <bool> preview;
    in property <bool> can-install;
    // Where the corner button lands. Empty when that is the editor — the panel shown
    // once after an update — and the screen's name when it was opened from Settings.
    in property <string> back-to;
    callback dismissed();
    callback changelog();
    callback install();

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    property <bool> shown: false;
    // One tick after the first paint, so the animations have a state to move FROM —
    // the same reason the welcome screen does it this way.
    Timer {
        interval: 40ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── the hero ──
        Rectangle {
            height: 132px;
            background: Theme.accent-soft;
            clip: true;

            // A wash that lifts the band away from a flat fill without becoming a
            // gradient: one soft disc, off-centre, behind the mark.
            Rectangle {
                x: parent.width - 210px;
                y: -66px;
                width: 240px;
                height: 240px;
                border-radius: 120px;
                background: Theme.accent;
                opacity: 0.10;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    MoonMark {
                        width: 92px;
                        height: 92px;
                        shown: root.shown;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 5px;
                    Text {
                        text: "Hub Moon " + root.version;
                        color: Theme.text;
                        font-size: 25px;
                        font-weight: 700;
                        opacity: root.shown ? 1.0 : 0.0;
                        animate opacity { duration: Theme.settle; easing: Theme.ease-enter; }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 7px;
                        // Not drawn at all when there is nothing to say. Opening
                        // What's New from Settings has no "from" — you are already
                        // running it — and an empty chip reading "from " is worse
                        // than no chip.
                        if root.from-version != "": Rectangle {
                            width: chip.preferred-width + 18px;
                            height: 21px;
                            border-radius: 11px;
                            background: Theme.card;
                            opacity: root.shown ? 1.0 : 0.0;
                            animate opacity { duration: Theme.settle; }
                            chip := Text {
                                text: (root.preview ? "you have " : "from ") + root.from-version;
                                color: Theme.sub;
                                font-family: Theme.mono;
                                font-size: 10.5px;
                                width: 100%;
                                height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.preview ? "not installed yet — this is what changes"
                                : root.from-version != "" ? "already installed and running"
                                : "what is in the version you are running";
                            color: Theme.sub;
                            font-size: 11.5px;
                            vertical-alignment: center;
                            opacity: root.shown ? 1.0 : 0.0;
                            animate opacity { duration: Theme.settle; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    padding-top: 14px;
                    IconBtn {
                        icon: root.back-to == "" ? Icons.close : Icons.arrow-back;
                        clicked => { root.dismissed(); }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // ── what changed ──
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            Flickable {
                // Without this the viewport is as wide as the longest line wants to
                // be, and `wrap: word-wrap` never gets a width to wrap against — the
                // notes ran off the edge instead of wrapping.
                viewport-width: self.width;
                viewport-height: notelist.preferred-height;
                notelist := VerticalLayout {
                    width: parent.width;
                    padding: 12px;
                    padding-bottom: 4px;
                    spacing: 2px;
                    for n[i] in root.notes: NoteLine {
                        body: n;
                        rank: i;
                        shown: root.shown;
                    }
                    // A release whose manifest carried no notes still says something
                    // true rather than showing an empty box.
                    if root.notes.length == 0: Text {
                        text: root.preview
                            ? "No notes came with this release. The full changelog is on the website."
                            : "This version is installed and running. The full changelog is on the website.";
                        color: Theme.sub;
                        font-size: 12.5px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            padding: 14px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                TextBtn {
                    label: "Full changelog";
                    icon: Icons.note;
                    clicked => { root.changelog(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Read it, then act on it — without going back to Settings to find the
            // button again. Only when there is something this build can actually
            // install: offering "Install" on a copy that has to be updated by pacman
            // would be a button that cannot keep its word.
            if root.preview && root.can-install: VerticalLayout {
                alignment: center;
                TextBtn {
                    label: "Not now";
                    icon: Icons.close;
                    clicked => { root.dismissed(); }
                }
            }
            VerticalLayout {
                alignment: center;
                TextBtn {
                    label: root.preview
                        ? (root.can-install ? "Install it" : "Close")
                        : "Get on with it";
                    icon: root.preview && root.can-install ? Icons.download : Icons.check;
                    primary: true;
                    clicked => {
                        if (root.preview && root.can-install) { root.install(); }
                        else { root.dismissed(); }
                    }
                }
            }
        }
    }
}

component ProfileCard inherits Rectangle {
    in property <ProfileRow> entry;
    callback applied();
    callback removed();

    height: 54px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.card-2 : Theme.card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.line-2 : Theme.line;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.applied(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.note;
                color: Theme.faint;
                font-size: 11px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            // Delete is its own hit target rather than a hover-reveal: a control that
            // only exists while the pointer is over it is one you cannot reach with a
            // keyboard and cannot find on a touchscreen.
            IconBtn {
                icon: Icons.remove;
                clicked => { root.removed(); }
            }
        }
    }
}

// A recent curve. Two actions and they are different in kind: put it back, or keep
// it — history rolls over on its own, a profile is permanent.
component HistoryCard inherits Rectangle {
    in property <HistoryRow> entry;
    callback applied();
    callback kept();

    height: 46px;
    border-radius: Theme.r-md;
    background: touch.has-hover ? Theme.accent-soft : Theme.card-2;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent-line : Theme.line;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.applied(); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.entry.name;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.entry.note;
                color: Theme.faint;
                font-family: Theme.mono;
                font-size: 9px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            TextBtn {
                label: "keep";
                icon: Icons.save;
                clicked => { root.kept(); }
            }
        }
    }
}


component AeqCard inherits Rectangle {
    in property <AeqRow> entry;
    callback picked();

    height: 54px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.card-2 : Theme.card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.line-2 : Theme.line;
    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.model;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            // Who measured it, in the accent — because a search for one headphone
            // returns a dozen rows with an identical name, and the measurer is the
            // only thing telling them apart. Drawn quietly it inverted the hierarchy:
            // the loud half of every row was the half they all agreed on.
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.entry.source;
                    color: Theme.accent;
                    font-family: Theme.mono;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.entry.form + (root.entry.shape == "" ? "" : "  ·  " + root.entry.shape);
                    color: Theme.faint;
                    font-family: Theme.mono;
                    font-size: 10px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }
        // The correction itself. Two measurements of one headphone disagree, and this
        // is where you can see by how much before applying either.
        Rectangle {
            width: 108px;
            height: 30px;
            clip: true;
            y: (parent.height - 30px) / 2;
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 108;
                viewbox-height: 30;
                commands: root.entry.curve;
                stroke: touch.has-hover ? Theme.accent : Theme.curve;
                stroke-width: 1.5px;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component LibTab inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <int> count;
    in property <bool> active;
    callback picked();

    height: 34px;
    border-radius: Theme.r-sm;
    background: root.active ? Theme.accent-soft
        : (hover.has-hover ? Theme.card-2 : transparent);
    animate background { duration: Theme.quick; easing: Theme.ease-state; }

    hover := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Sym {
                d: root.icon;
                sz: 15px;
                tint: root.active ? Theme.accent : Theme.sub;
                width: 15px;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.sub;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
        // Zero is not drawn. A count of nothing is the one number that reads as a
        // fault rather than as information.
        if root.count > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 16px;
                width: num.preferred-width + 12px;
                border-radius: 8px;
                background: root.active ? Theme.accent : Theme.card-2;
                num := Text {
                    text: root.count;
                    color: root.active ? Theme.accent-ink : Theme.faint;
                    font-family: Theme.mono;
                    font-size: 9.5px;
                    font-weight: 700;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // The active tab is underlined into the panel below it, which is what says the
    // list belongs to this tab rather than sitting near it.
    if root.active: Rectangle {
        y: parent.height - 2px;
        x: 10px;
        width: parent.width - 20px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}

// A search box. Three of these were written out by hand in three sheets, differing
// only in their placeholder and in one of them having forgotten the hint entirely.
component SearchBox inherits Rectangle {
    in property <string> hint;
    in-out property <string> text <=> field.text;
    callback edited(string);

    horizontal-stretch: 1;
    border-radius: Theme.r-sm;
    background: Theme.card-2;
    border-width: 1px;
    border-color: field.has-focus ? Theme.accent : Theme.line-2;
    animate border-color { duration: Theme.quick; easing: Theme.ease-state; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        Sym { d: Icons.search; sz: 15px; tint: Theme.faint; width: 15px; }
        // The hint sits *behind* the field rather than beside it — as a sibling in
        // the layout it took its own column and pushed the caret into the middle of
        // the box.
        Rectangle {
            horizontal-stretch: 1;
            field := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
            }
            if field.text == "": Text {
                x: 0px;
                width: 100%;
                height: 100%;
                text: root.hint;
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

// A sideways strip of filter chips: curve shapes in the community tab, measurers in
// the headphones tab. Both are "narrow this list by an attribute that is not in its
// name", and both scroll because there are more than fit.
component ChipStrip inherits Rectangle {
    in property <[ShapeRow]> chips;
    in property <string> active;
    callback picked(string);

    height: 24px;
    clip: true;
    Flickable {
        width: 100%;
        height: 100%;
        viewport-width: row.preferred-width;
        viewport-height: self.height;
        row := HorizontalLayout {
            spacing: 6px;
            height: 24px;
            for c in root.chips: ShapeChip {
                label: c.name;
                count: c.count;
                active: root.active == c.name;
                picked => { root.picked(c.name); }
            }
        }
    }
}

// The library: four sources for a curve, one screen.
//
// These were three separate sheets — community, headphones, saved profiles — and each
// was the same screen: a list of curves you can search, filtered somehow, previewed
// before it goes anywhere near the DAC. They had three search boxes, three empty
// states, three list panes and three sets of the same layout bugs, and history was
// about to become a fourth. Everything outside the rows themselves is written once
// here; the rows differ because the things genuinely differ.
//
// The entry points do not merge. The headphones button still opens the headphones
// tab — landing somewhere you did not ask for, one click from where you did, is not
// an improvement. What changes is that the other three are now one click away instead
// of a close and a reopen.
component LibrarySheet inherits Rectangle {
    // Sheets used to exist between one frame and the next: `if open: Sheet {}` puts
    // the whole panel on screen at once. `init` flips this the moment the element is
    // built, so the opacity binding has something to animate from — an entrance, not a
    // cut. Closing is still immediate: `if` destroys the element, and holding a heavy
    // sheet alive purely to fade it out is a cost paid on every frame it is open.
    property <bool> entered;
    init => { root.entered = true; }
    opacity: root.entered ? 1.0 : 0.0;
    animate opacity { duration: Theme.screen; easing: Theme.ease-enter; }

    // 0 saved · 1 recent · 2 community · 3 headphones. The order the bridge's
    // LIB_TABS is in — mine first, then everybody else's.
    in property <int> tab;
    in property <string> note;
    // Empty when a step back lands on the editor; the screen's name when this one was
    // opened from another.
    in property <string> back-to;

    in property <[ProfileRow]> profiles;
    in property <int> profile-count;
    in property <[HistoryRow]> history;
    in property <int> history-count;

    in property <[HubRow]> hub-rows;
    in property <int> hub-count;
    in property <bool> hub-busy;
    in property <[string]> sorts;
    in property <int> sort-index;
    in property <bool> own-only;
    in property <[ShapeRow]> shapes;
    in property <string> shape;

    in property <[AeqRow]> aeq-rows;
    in property <int> aeq-count;
    in property <bool> aeq-busy;
    in property <[ShapeRow]> sources;
    in property <string> source;

    callback closed();
    callback tab-picked(int);

    callback named(string);
    callback saved();
    callback profile-applied(string);
    callback profile-removed(string);

    callback history-applied(string);
    callback history-kept(string);
    callback history-cleared();

    callback hub-searched(string);
    callback hub-reloaded();
    callback hub-applied(string);
    callback sorted(int);
    callback own-picked(bool);
    callback shape-picked(string);

    callback aeq-searched(string);
    callback aeq-reloaded();
    callback aeq-picked(string, string, string);
    callback source-picked(string);

    property <bool> busy: root.tab == 2 ? root.hub-busy
        : (root.tab == 3 ? root.aeq-busy : false);
    property <int> count: root.tab == 0 ? root.profile-count
        : (root.tab == 1 ? root.history-count
        : (root.tab == 2 ? root.hub-count : root.aeq-count));

    background: Theme.card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.line-2;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 11px;

        SheetHead {
            title: "Library";
            note: root.busy ? "working…" : root.note;
            back-to: root.back-to;
            closed => { root.closed(); }
        }

        HorizontalLayout {
            spacing: 2px;
            height: 34px;
            alignment: start;
            LibTab {
                label: "Saved";
                icon: Icons.favorite;
                count: root.profile-count;
                active: root.tab == 0;
                picked => { root.tab-picked(0); }
            }
            LibTab {
                label: "Recent";
                icon: Icons.undo;
                count: root.history-count;
                active: root.tab == 1;
                picked => { root.tab-picked(1); }
            }
            LibTab {
                label: "Community";
                icon: Icons.groups;
                count: root.hub-count;
                active: root.tab == 2;
                picked => { root.tab-picked(2); }
            }
            LibTab {
                label: "Headphones";
                icon: Icons.headphones;
                count: root.aeq-count;
                active: root.tab == 3;
                picked => { root.tab-picked(3); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // ── the controls that belong to the tab you are on ──
        if root.tab == 0: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.r-sm;
                background: Theme.card-2;
                border-width: 1px;
                border-color: pname.has-focus ? Theme.accent : Theme.line-2;
                animate border-color { duration: Theme.quick; easing: Theme.ease-state; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Rectangle {
                        pname := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Theme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.named(self.text); }
                            accepted => { root.saved(); pname.text = ""; }
                        }
                        if pname.text == "": Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: "name this curve…";
                            color: Theme.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            TextBtn {
                label: "save curve";
                icon: Icons.save;
                primary: true;
                enabled: pname.text != "";
                clicked => { root.saved(); pname.text = ""; }
            }
        }

        // Just the button. The footer already says what this list is, and saying it
        // here as well is the same panel explaining itself to you twice.
        if root.tab == 1: HorizontalLayout {
            height: 30px;
            alignment: end;
            TextBtn {
                label: "clear";
                icon: Icons.close;
                enabled: root.history-count > 0;
                clicked => { root.history-cleared(); }
            }
        }

        if root.tab == 2: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            SearchBox {
                hint: "search the community library…";
                edited(t) => { root.hub-searched(t); }
            }
            TextBtn {
                label: "reload";
                icon: Icons.refresh;
                enabled: !root.hub-busy;
                clicked => { root.hub-reloaded(); }
            }
        }
        // Which library, and in what order. Both are local — the index is already on
        // disk, so neither costs a request.
        if root.tab == 2: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            Segmented {
                // Wider than the default 190: "Whole family" is a longer label than
                // this control was built for and sat against its rounded edge.
                width: 212px;
                left: "This DAC";
                right: "Whole family";
                on-right: !root.own-only;
                picked(v) => { root.own-picked(!v); }
            }
            Choice {
                horizontal-stretch: 1;
                options: root.sorts;
                index: root.sort-index;
                picked(i) => { root.sorted(i); }
            }
        }
        // What the curves actually do — derived from the bands, because 25 of the
        // library's 9,243 rows carry a tag and nothing can be filtered on that. Chips
        // appear as their curves are classified, and only for shapes something
        // matched, so no chip ever leads to an empty list.
        if root.tab == 2 && root.shapes.length > 0: ChipStrip {
            chips: root.shapes;
            active: root.shape;
            picked(n) => { root.shape-picked(n); }
        }

        if root.tab == 3: HorizontalLayout {
            spacing: 8px;
            height: 30px;
            SearchBox {
                // No count in the hint. It said "6,015 headphones" against a
                // catalogue that has 8,827 in it today — a number written into the
                // view drifts the moment upstream publishes anything. The real one is
                // in the note beside the title, where it comes from the data.
                hint: "search the headphone catalogue…";
                edited(t) => { root.aeq-searched(t); }
            }
            TextBtn {
                label: "reload";
                icon: Icons.refresh;
                enabled: !root.aeq-busy;
                clicked => { root.aeq-reloaded(); }
            }
        }
        // Who measured it. One headphone comes back measured by a dozen people on a
        // dozen rigs, and picking a measurer is the only filter that narrows *that* —
        // searching harder cannot, because every one of those rows has the same name.
        if root.tab == 3 && root.sources.length > 0: ChipStrip {
            chips: root.sources;
            active: root.source;
            picked(n) => { root.source-picked(n); }
        }

        // ── the list ──
        Rectangle {
            vertical-stretch: 1;
            // An empty list must still hold the sheet open. A Flickable reports its
            // viewport as its own height preference, and with no rows in it that is
            // zero — which propagated up as this Rectangle's maximum, so the one child
            // meant to stretch could not, `clip: true` swallowed the "nothing here"
            // message, and the footer rode up under the search box leaving a third of
            // the sheet blank. The Flickable fills the space it is given;
            // `viewport-height` only ever describes what scrolls inside it.
            min-height: 120px;
            clip: true;

            if root.tab == 0: cprof := LazyRows {
                pitch: 61px;                    // 54px card + 7px gap
                row-height: 54px;
                count: root.profiles.length;
                for r[i] in root.profiles: Rectangle {
                    y: i * 61px;
                    height: 54px;
                    width: 100%;
                    if cprof.shown(i): ProfileCard {
                        entry: r;
                        applied => { root.profile-applied(r.name); }
                        removed => { root.profile-removed(r.name); }
                    }
                }
            }
            if root.tab == 1: chist := LazyRows {
                pitch: 52px;                    // 46px card + 6px gap
                row-height: 46px;
                count: root.history.length;
                for h[i] in root.history: Rectangle {
                    y: i * 52px;
                    height: 46px;
                    width: 100%;
                    if chist.shown(i): HistoryCard {
                        entry: h;
                        applied => { root.history-applied(h.fingerprint); }
                        kept => { root.history-kept(h.fingerprint); }
                    }
                }
            }
            if root.tab == 2: chub := LazyRows {
                pitch: 73px;                    // 66px card + 7px gap
                row-height: 66px;
                count: root.hub-rows.length;
                for r[i] in root.hub-rows: Rectangle {
                    y: i * 73px;
                    height: 66px;
                    width: 100%;
                    if chub.shown(i): HubCard {
                        entry: r;
                        applied => { root.hub-applied(r.uuid); }
                    }
                }
            }
            if root.tab == 3: caeq := LazyRows {
                pitch: 61px;                    // 54px card + 7px gap
                row-height: 54px;
                count: root.aeq-rows.length;
                for r[i] in root.aeq-rows: Rectangle {
                    y: i * 61px;
                    height: 54px;
                    width: 100%;
                    if caeq.shown(i): AeqCard {
                        entry: r;
                        picked => { root.aeq-picked(r.model, r.source, r.form); }
                    }
                }
            }

            if root.count == 0 && !root.busy: VerticalLayout {
                y: 24px;
                // `alignment: start`, or the two lines are stretched to fill the whole
                // empty pane and end up 300px apart — a heading at the top of the
                // sheet and its own second sentence down by the footer, reading as two
                // unrelated messages.
                alignment: start;
                spacing: 5px;
                Text {
                    text: root.tab == 0 ? "Nothing saved yet."
                        : (root.tab == 1 ? "Nothing applied yet this session."
                        : (root.tab == 2 ? "Nothing here."
                        : "No headphone matches that."));
                    color: Theme.sub;
                    font-size: 13px;
                    font-weight: 600;
                    width: 100%;
                    horizontal-alignment: center;
                }
                // An empty list should say what to do about it. "Nothing here" on its
                // own is a dead end three of these four tabs can be talked out of.
                Text {
                    text: root.tab == 0 ? "Name the curve you have now and save it."
                        : (root.tab == 1 ? "Apply a preset or a community curve and it turns up here."
                        : (root.tab == 2 ? "Try a different search, widen it to the whole family, or reload."
                        : "Try part of the name — “hd 600” finds the HD 600 under every measurer."));
                    color: Theme.faint;
                    font-size: 11.5px;
                    width: 100%;
                    horizontal-alignment: center;
                }
            }
        }

        Text {
            text: root.tab == 0 ? "Saved on this computer, not on the DAC — so there is no limit and they survive a device slot being overwritten. Each file is an ordinary export: mail one to somebody and they can import it."
                : (root.tab == 1 ? "The last curves you applied, kept until they roll off the end of the list. Keeping one makes it a saved profile, which nothing rolls off."
                : (root.tab == 2 ? "Click any config to see its curve before it goes anywhere near your DAC."
                : "AutoEQ publishes ten filters per headphone and this DAC has eight, so two are always left out — the preview names them. Corrections by Jaakko Pasanen and the measurers credited on each row (MIT)."));
            color: Theme.faint;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}


// ── window ──────────────────────────────────────────────────────────────────────
export component MainWindow inherits Window {
    title: "Hub Moon";
    // The window icon — the titlebar and the taskbar button. Not the same thing as the
    // icon PyInstaller stamps into the .exe, which is what Explorer and the shortcut
    // show; through 1.0.0 only that one was set, so Windows drew the shell's generic
    // placeholder on the window itself. Rendered from packaging/hub-moon.svg, and it
    // has to be a real file next to this one because .slint sources are compiled at
    // startup. Wayland has no protocol for window icons and ignores it; X11, Windows
    // and macOS all use it.
    icon: @image-url("hub-moon.png");
    background: Theme.bg;
    preferred-width: 1240px;
    preferred-height: 820px;
    min-width: 980px;
    min-height: 700px;
    // Why a maximum on a window that has no maximum.
    //
    // A tiling compositor decides float-vs-tile from the size constraints the surface
    // carries on its FIRST commit, and that decision is taken once. Slint's first
    // layout runs before the bridge has pushed a single row, and with empty models
    // nothing in the tree stretches horizontally — so the computed maximum width
    // collapses to the declared minimum and the toplevel maps advertising
    // `set_max_size(980, …)`: "I cannot be wider than my own minimum". Hyprland reads
    // that as a window it cannot tile and floats it. Slint corrects itself ~80 ms
    // later with `set_max_size(0, 0)`, microseconds after the first buffer is
    // attached, which is already too late.
    //
    // That race is why the same code tiles from source and floats from the frozen
    // bundle: the two measure text slightly differently and land on opposite sides of
    // it. Declaring the maximum here puts an unbounded one on the first commit, which
    // is the truth about this window, and removes the race rather than winning it.
    // Verified against the frozen 1.2.0 bundle: floating before, tiled after.
    max-width: 100000px;
    full-screen: root.want-fullscreen;

    // Below this the header and footer stop showing button labels. It is not the
    // window's minimum — a tiling compositor hands the app whatever the tile is,
    // happily less than the minimum it asked for, so "too narrow" is a state the
    // layout has to survive rather than one it can refuse.
    // Assigned, not bound. A binding would read the window's width, which is derived
    // in part from what its children want — and the header's subtitle changes length
    // on this very property. Slint spots the cycle and says it "may cause panic at
    // runtime"; a `changed` handler runs after the width settles and closes it.
    property <bool> narrow;
    changed width => { root.narrow = root.width < 1100px; }

    // ── state, pushed in from the bridge ──
    in property <bool> connected;
    in property <bool> busy;
    in property <bool> dirty;
    in property <string> device-name: "No device";
    in property <string> firmware;
    in property <int> band-count: 8;
    in property <float> pregain;
    in property <bool> supports-pregain: true;
    in property <float> global-gain;
    in property <int> slot: -1;
    // What the profile row says under its number, and whether the DAC is playing one of
    // its own presets rather than the curve this app owns.
    in property <string> slot-note;
    in property <bool> slot-on-builtin;
    in property <bool> clipping;
    in property <string> headroom-hint;
    in property <[BandRow]> bands;
    in property <[PresetRow]> presets;
    in property <string> active-preset;
    // "Community · aira 咏叹调 (edited)", or empty when nothing is known about the
    // curve on the device — which is not the same as it being hand-drawn.
    in property <string> source-label;
    in property <[HistoryRow]> history-rows;
    in property <int> history-count;
    in property <string> curve-path;
    in property <string> flat-path;
    in property <string> pregain-path;
    in property <string> readout-path;
    in property <string> readout-flat-path;
    in property <string> readout-grid-path;
    in property <bool> readout;
    in property <bool> dark;
    in property <int> accent-index;
    in property <int> skin-index;
    in property <bool> welcome-open;
    in property <string> toast-text;
    in property <bool> toast-error;
    in property <int> selected: -1;
    // Which screen is up — "" is the editor — and what a step back returns to. One
    // property instead of a boolean per screen: see gui/nav.py.
    in property <string> nav;
    in property <string> nav-under;
    // Which of the library's four sources is showing, and the count line under its
    // title. Both are the bridge's — the view has no way to know how many of 9,243
    // rows passed a filter, and working it out here would be maths in the view.
    in property <int> lib-tab;
    in property <string> lib-note;
    in property <int> prof-count;
    in property <[ProfileRow]> prof-rows;
    in property <bool> aeq-busy;
    in property <int> aeq-count;
    in property <[AeqRow]> aeq-rows;
    in property <[ShapeRow]> aeq-sources;
    in property <string> aeq-source;
    in property <bool> hub-busy;
    in property <int> hub-count;
    in property <[HubRow]> hub-rows;
    in property <[string]> hub-sorts;
    in property <int> hub-sort;
    in property <bool> hub-own;
    in property <[ShapeRow]> hub-shapes;
    in property <string> hub-shape;
    in property <bool> preview-open;
    in property <string> preview-title;
    in property <string> preview-author;
    in property <string> preview-desc;
    in property <string> preview-note;
    in property <string> preview-curve-path;
    in property <string> preview-flat-path;
    in property <string> app-version;
    in property <string> settings-path;
    in property <bool> opt-fullscreen;
    in property <bool> opt-watch;
    in property <bool> opt-prefetch;
    in property <bool> opt-history;
    in property <[string]> motion-labels;
    in property <int> opt-motion;
    // Set from Python once the window exists — see Bridge.start(). Declaring
    // `full-screen: true` here does nothing at all: winit only acts on a change.
    in property <bool> want-fullscreen;
    // "idle" | "checking" | "current" | "available" | "downloading" | "staged"
    in property <string> update-state: "idle";
    in property <string> update-note;
    in property <string> update-version;
    in property <string> update-hint;
    in property <string> update-command;
    in property <bool> update-can-fetch;
    in property <bool> update-rollback;
    in property <bool> update-can-elevate;
    in property <string> update-reason;
    in property <float> update-progress;
    in property <bool> update-can-install;
    in property <int> update-channel;
    in property <bool> update-auto;
    in property <string> install-note;
    in property <string> about-text;
    in property <[GuidePage]> guide-pages;
    in property <bool> comparing;
    in property <int> soloed;
    in property <bool> can-undo;
    // -1 when the walkthrough is not running; 0-4 while it is.
    in property <int> tour-step: -1;
    in property <string> tour-head;
    in property <string> tour-body;
    in property <[DeviceRow]> device-rows;
    in property <string> device-note;
    in property <string> whatsnew-from;
    in property <string> whatsnew-version;
    in property <bool> whatsnew-preview;
    in property <[string]> whatsnew-notes;

    // ── everything the view can ask for ──
    callback refresh();
    callback save-flash();
    callback revert();
    callback plot-resized(length, length);
    callback select-band(int);
    callback set-pregain(float);
    callback set-global-gain(float);
    callback match-headroom();
    callback step-slot(int);
    callback plot-press(float, float);
    callback plot-move(float, float);
    callback plot-release();
    callback plot-scroll(float);
    callback set-band-gain(int, float);
    callback commit-band-edit(int);
    callback step-freq(int, int);
    callback step-q(int, int);
    callback cycle-type(int, int);
    callback apply-preset(int);
    callback import-file();
    callback export-file();
    callback toggle-help();
    callback toggle-settings();
    callback set-dark(bool);
    callback set-readout(bool);
    callback set-accent(int);
    callback set-skin(int);
    callback dismiss-welcome();
    callback show-welcome();
    callback toggle-community();
    callback library-tab(int);
    callback reselect-custom();
    callback toggle-profiles();
    callback profile-name-edited(string);
    callback profile-save();
    callback profile-apply(string);
    callback profile-delete(string);
    callback toggle-autoeq();
    callback autoeq-search(string);
    callback autoeq-reload();
    callback autoeq-pick(string, string, string);
    callback community-search(string);
    callback community-sort(int);
    callback community-own(bool);
    callback community-shape(string);
    callback autoeq-source(string);
    callback set-switch(string, bool);
    callback set-motion(int);
    callback history-apply(string);
    callback history-keep(string);
    callback history-clear();
    callback community-apply(string);
    callback community-reload();
    callback preview-apply();
    callback preview-close();
    callback dismiss-toast();
    callback check-update();
    callback install-update();
    callback skip-update();
    callback set-channel(int);
    callback set-auto-update(bool);
    callback open-logs();
    callback open-notes();
    callback copy-diagnostics();
    callback copy-update-command();
    callback toggle-band(int);
    callback compare-hold(bool);
    callback step-gain(int, int, bool);
    callback reset-band(int);
    callback solo-band(int);
    callback undo();
    callback toggle-devices();
    callback start-tour();
    callback tour-next();
    callback tour-end();
    // One step back, wherever you are. Every sheet's close button, the back arrow
    // and Escape are the same action.
    callback nav-pop();
    callback show-whatsnew();
    callback preview-whatsnew();
    callback restart-app();

    property <bool> sheet-open: root.nav != "";

    // Theme is a global, and a global cannot bind to a property on a component — so the
    // flow runs the other way: the bridge pushes `dark` here and this forwards it once.
    // `init` covers the first paint, `changed` every flip after it.
    init => {
        root.narrow = root.width < 1100px;
        Theme.dark = root.dark;
        Theme.accent-index = root.accent-index;
        Theme.skin-index = root.skin-index;
        keys.focus();
    }

    // A zero-size FocusScope rather than one wrapped around the layout: it only needs
    // to hold focus, and wrapping the whole window would put a focus boundary between
    // every control and the pointer for no gain. Text fields still get keys first —
    // they consume what they use and let the rest through.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            // Escape closes the topmost thing that is over the app, in the order it
            // is stacked. The welcome screen is deliberately not in this list: it is
            // where you are, not something on top of you.
            if (e.text == Key.Escape) {
                // The preview is the one thing that draws over a sheet rather than
                // instead of it, so it is the one thing tested before the stack.
                if (root.preview-open) { root.preview-close(); }
                else if (root.sheet-open) { root.nav-pop(); }
                else if (root.toast-text != "") { root.dismiss-toast(); }
                return EventResult.accept;
            }
            if (e.modifiers.control && e.text == "s") {
                root.save-flash();
                return EventResult.accept;
            }
            if (e.modifiers.control && e.text == "r") {
                root.refresh();
                return EventResult.accept;
            }
            if (e.modifiers.control && e.text == "z") {
                root.undo();
                return EventResult.accept;
            }

            // Everything past here edits the curve, so it is off while any sheet is
            // open: those contain search fields, and a tool that answers "m" by
            // muting a band while you are typing "moondrop" into a search box is a
            // tool people turn the keyboard off in.
            if (root.sheet-open || root.welcome-open) { return EventResult.reject; }

            // Hold to compare. Released below — both edges matter, because the
            // release is what puts your curve back.
            if (e.text == " ") {
                root.compare-hold(true);
                return EventResult.accept;
            }

            // The band under the caret. Nothing selected means the first one, so the
            // keyboard is usable without reaching for the mouse to start.
            if (root.selected < 0 && root.bands.length > 0) { root.select-band(0); }

            if (e.text == Key.UpArrow) {
                root.step-gain(root.selected, 1, e.modifiers.shift);
                return EventResult.accept;
            }
            if (e.text == Key.DownArrow) {
                root.step-gain(root.selected, -1, e.modifiers.shift);
                return EventResult.accept;
            }
            if (e.text == Key.RightArrow) {
                root.step-freq(root.selected, 1);
                return EventResult.accept;
            }
            if (e.text == Key.LeftArrow) {
                root.step-freq(root.selected, -1);
                return EventResult.accept;
            }
            if (e.text == "[") { root.step-q(root.selected, -1); return EventResult.accept; }
            if (e.text == "]") { root.step-q(root.selected, 1); return EventResult.accept; }
            if (e.text == "m") { root.toggle-band(root.selected); return EventResult.accept; }
            if (e.text == "s") { root.solo-band(root.selected); return EventResult.accept; }
            if (e.text == "0") { root.reset-band(root.selected); return EventResult.accept; }

            // 1-8 pick a band, matching the number printed on its card and on the
            // graph handle — the same number the write actually targets.
            if (e.text >= "1" && e.text <= "8") {
                root.select-band(e.text.to-float() - 1);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        key-released(e) => {
            if (e.text == " ") {
                root.compare-hold(false);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    changed dark => { Theme.dark = root.dark; }
    changed accent-index => { Theme.accent-index = root.accent-index; }
    changed skin-index => { Theme.skin-index = root.skin-index; }

    VerticalLayout {
        spacing: 0;

        // ── header ──
        Rectangle {
            height: 62px;
            background: Theme.card;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    Mark { size: 28px; behind: Theme.card; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Hub Moon";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.narrow ? "\{root.band-count}-band · 96 kHz"
                            : "\{root.band-count}-band parametric EQ · DSP @ 96 kHz";
                        color: Theme.faint;
                        font-family: Theme.mono;
                        font-size: 9px;
                    }
                }

                // device chip — click to re-scan
                Rectangle {
                    y: 16px;
                    height: 30px;
                    width: chip.preferred-width + 22px;
                    border-radius: Theme.r-sm;
                    background: dev-touch.has-hover ? Theme.card-2 : Theme.bg;
                    border-width: 1px;
                    border-color: root.connected ? Theme.accent-line : Theme.line;
                    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }
                    dev-touch := TouchArea { mouse-cursor: pointer; clicked => { root.refresh(); } }
                    chip := HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 8px;
                        Sym {
                            d: root.connected ? Icons.headphones : Icons.usb-off;
                            sz: 15px;
                            width: 15px;
                            tint: root.connected ? Theme.accent : Theme.faint;
                        }
                        Text {
                            text: root.device-name;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: 12px;
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.connected ? Theme.good : Theme.faint;
                        }
                    }
                }

                if root.firmware != "": Rectangle {
                    y: 16px;
                    height: 30px;
                    width: fw.preferred-width + 18px;
                    border-radius: Theme.r-sm;
                    background: Theme.bg;
                    border-width: 1px;
                    border-color: Theme.line;
                    fw := Text {
                        text: "fw \{root.firmware}";
                        color: Theme.sub;
                        font-family: Theme.mono;
                        font-size: 11px;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // One spacer, so the whole right-hand group — pills and icons — sits
                // together at the right edge. Splitting it in two centred the pills
                // and stranded the icons on their own, and it was never the fix: the
                // gap that looked wrong was *inside* the buttons, not between them.
                Rectangle { horizontal-stretch: 1; }

                if root.dirty: Rectangle {
                    y: 16px;
                    height: 30px;
                    width: uns.preferred-width + 18px;
                    border-radius: Theme.r-sm;
                    background: Theme.warn-soft;
                    border-width: 1px;
                    border-color: Theme.warn;
                    uns := Text {
                        text: "unsaved";
                        color: Theme.warn;
                        font-family: Theme.mono;
                        font-size: 10px;
                        font-weight: 700;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Two groups, not six children. The header's own 12px spacing is the
                // gap between *groups*; inside a group the buttons belong together
                // and were being pushed apart by a number meant for something else —
                // three icons with 12px between each read as three unrelated things
                // parked near the corner.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        TextBtn {
                            label: "headphones";
                            icon: Icons.headphones;
                            compact: root.narrow;
                            clicked => { root.toggle-autoeq(); }
                        }
                        TextBtn {
                            label: "community";
                            icon: Icons.groups;
                            compact: root.narrow;
                            clicked => { root.toggle-community(); }
                        }
                        TextBtn {
                            label: "how to tune";
                            icon: Icons.help;
                            compact: root.narrow;
                            clicked => { root.toggle-help(); }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 2px;
                        IconBtn {
                            icon: Icons.home;
                            active: root.welcome-open;
                            clicked => { root.show-welcome(); }
                        }
                        IconBtn {
                            icon: Icons.tune;
                            active: root.nav == "settings";
                            clicked => { root.toggle-settings(); }
                        }
                        IconBtn {
                            icon: Icons.refresh;
                            tint: Theme.sub;
                            clicked => { root.refresh(); }
                        }
                    }
                }
            }
        }

        // ── body ──
        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // control row
            ctl-row := HorizontalLayout {
                spacing: 10px;
                height: 62px;
                SlotCard {
                    // Wider than it was: the row now carries a recovery button on the
                    // one state where it is needed, and 190px put it on top of the
                    // stepper.
                    width: root.slot-on-builtin ? 258px : 190px;
                    slot: root.slot;
                    note: root.slot-note;
                    on-builtin: root.slot-on-builtin;
                    enabled: root.connected;
                    stepped(d) => { root.step-slot(d); }
                    mine => { root.reselect-custom(); }
                }
                SliderCard {
                    horizontal-stretch: 1;
                    label: "PRE-GAIN";
                    caption: root.clipping ? "clipping · \{root.headroom-hint}" : "headroom";
                    minimum: -12;
                    maximum: 0;
                    value: root.pregain;
                    enabled: root.supports-pregain;
                    alert: root.clipping;
                    action: root.clipping ? "match" : "";
                    readout: "\{round(root.pregain * 10) / 10} dB";
                    moved(v) => { root.set-pregain(v); }
                    action-clicked => { root.match-headroom(); }
                }
                SliderCard {
                    horizontal-stretch: 1;
                    label: "GLOBAL OFFSET";
                    caption: "volume";
                    minimum: -12;
                    maximum: 6;
                    value: root.global-gain;
                    enabled: root.connected;
                    readout: "\{round(root.global-gain * 10) / 10} dB";
                    moved(v) => { root.set-global-gain(v); }
                }
            }

            // presets
            preset-row := HorizontalLayout {
                spacing: 6px;
                height: 30px;
                Text {
                    text: "PRESETS";
                    color: Theme.faint;
                    font-family: Theme.mono;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                    width: 62px;
                }
                for p[i] in root.presets: pill := Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.r-sm;
                    property <bool> on: p.name == root.active-preset;
                    background: self.on ? Theme.accent
                              : (pt.has-hover ? Theme.accent-soft : Theme.card);
                    border-width: 1px;
                    border-color: self.on ? Theme.accent : Theme.line;
                    animate background, border-color { duration: Theme.quick; easing: Theme.ease-state; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Sym {
                            d: p.icon;
                            sz: 14px;
                            width: 14px;
                            tint: pill.on ? Theme.accent-ink : Theme.accent;
                        }
                        Text {
                            text: p.name;
                            color: pill.on ? Theme.accent-ink : Theme.text;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    pt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.apply-preset(i); }
                    }
                }
            }

            // What is on the device, and whether it is still what was applied. Sits
            // between the presets and the plot because that is the reading order of
            // the question it answers: I picked something — what is it now?
            //
            // Absent, not empty, when nothing is known. A curve whose origin this
            // machine never recorded gets no chip rather than a chip claiming it was
            // drawn by hand.
            if root.source-label != "": HorizontalLayout {
                height: 18px;
                spacing: 7px;
                Sym { d: Icons.note; sz: 12px; tint: Theme.faint; width: 12px; }
                Text {
                    text: root.source-label;
                    color: Theme.faint;
                    font-family: Theme.mono;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            graph := ResponseGraph {
                vertical-stretch: 1;
                curve-path: root.curve-path;
                flat-path: root.flat-path;
                pregain-path: root.pregain-path;
                readout-path: root.readout-path;
                readout-flat-path: root.readout-flat-path;
                readout-grid-path: root.readout-grid-path;
                readout: root.readout;
                bands: root.bands;
                selected: root.selected;
                toggled => { root.set-readout(!root.readout); }
                resized(w, h) => { root.plot-resized(w, h); }
                press(fx, fy) => { root.plot-press(fx, fy); }
                move(fx, fy) => { root.plot-move(fx, fy); }
                release => { root.plot-release(); }
                scrolled(d) => { root.plot-scroll(d); }
            }

            // band strip
            band-row := HorizontalLayout {
                spacing: 8px;
                height: 250px;
                for band in root.bands: BandCard {
                    horizontal-stretch: 1;
                    band: band;
                    selected: root.selected == band.index;
                    picked => { root.select-band(band.index); }
                    muted => { root.toggle-band(band.index); }
                    gain-moved(f) => { root.set-band-gain(band.index, -12 + f * 24); }
                    gain-released => { root.commit-band-edit(band.index); }
                    type-cycled(d) => { root.cycle-type(band.index, d); }
                    freq-stepped(d) => { root.step-freq(band.index, d); }
                    q-stepped(d) => { root.step-q(band.index, d); }
                }
            }

            // footer
            act-bar := HorizontalLayout {
                spacing: 8px;
                height: 30px;
                Text {
                    text: "drag graph points · scroll = Q · right-click a filter type to cycle back · esc closes · ctrl+S saves to flash";
                    color: Theme.faint;
                    font-family: Theme.mono;
                    font-size: 10px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                TextBtn { label: "profiles"; icon: Icons.favorite; compact: root.narrow; clicked => { root.toggle-profiles(); } }
                TextBtn { label: "import"; icon: Icons.upload-file; compact: root.narrow; clicked => { root.import-file(); } }
                TextBtn { label: "export"; icon: Icons.download; compact: root.narrow; clicked => { root.export-file(); } }
                // Hold, do not click. A/B is a comparison you make with your ears
                // over a few seconds of music, and a toggle makes you look at the
                // screen to find out which side you are on.
                HoldBtn {
                    label: root.comparing ? "bypassed" : "compare";
                    icon: Icons.tune;
                    held: root.comparing;
                    changed(v) => { root.compare-hold(v); }
                }
                TextBtn {
                    label: "undo";
                    icon: Icons.undo;
                    enabled: root.can-undo;
                    compact: root.narrow;
                    clicked => { root.undo(); }
                }
                TextBtn { label: "revert"; icon: Icons.restart-alt; compact: root.narrow; clicked => { root.revert(); } }
                TextBtn { label: "reload"; icon: Icons.refresh; compact: root.narrow; clicked => { root.refresh(); } }
                TextBtn {
                    label: "save to flash";
                    icon: Icons.save;
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.save-flash(); }
                }
            }
        }
    }

    // ── toast ──
    if root.toast-text != "": Rectangle {
        x: (root.width - 560px) / 2;
        y: root.height - 86px;
        width: 560px;
        height: 46px;
        border-radius: Theme.r-md;
        background: root.toast-error ? Theme.bad-soft : Theme.card;
        border-width: 1px;
        border-color: root.toast-error ? Theme.bad : Theme.line-2;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 10px;
            Sym {
                d: root.toast-error ? Icons.error : Icons.info;
                sz: 16px;
                width: 16px;
                tint: root.toast-error ? Theme.bad : Theme.accent;
            }
            Text {
                text: root.toast-text;
                color: root.toast-error ? Theme.bad : Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            VerticalLayout {
                alignment: center;
                IconBtn { icon: Icons.close; sz: 14px; clicked => { root.dismiss-toast(); } }
            }
        }
    }

    // ── sheets ──
    // A scrim, so a sheet reads as being over the app rather than beside it — and so a
    // stray click lands on the scrim instead of dragging a handle underneath.
    if root.sheet-open: Rectangle {
        // `root` and not `parent`: inside a conditional the parent is the branch, not
        // the window, so a `parent.width` scrim collapses to nothing and the app stays
        // fully clickable behind the sheet that is supposedly covering it.
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        // Near-black, not a tinted plum: the scrim has to darken in BOTH themes, and a
        // #2b2126 wash over a #171216 ground is the same colour twice — it renders, it
        // just does nothing, which looks exactly like a scrim that failed to lay out.
        background: #0a0709aa;
        TouchArea {
            clicked => { root.nav-pop(); }
        }
    }
    if root.nav == "settings": SettingsSheet {
        back-to: root.nav-under;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        // The largest sheet in the app, and deliberately so. It is the only one whose
        // rows are description-plus-control rather than a list: width here goes
        // straight into how many lines each description takes, and 620px was making
        // three-line notes out of two-line sentences.
        width: min(760px, root.width - 56px);
        // Its own content height, floored so a two-row tab still reads as a dialog and
        // capped by the window. It scrolls inside either way.
        height: clamp(self.wanted, 340px, min(820px, root.height - 60px));
        dark: root.dark;
        readout: root.readout;
        accent-index: root.accent-index;
        skin-index: root.skin-index;
        settings-path: root.settings-path;
        app-version: root.app-version;
        update-state: root.update-state;
        update-note: root.update-note;
        update-version: root.update-version;
        update-hint: root.update-hint;
        update-command: root.update-command;
        update-can-fetch: root.update-can-fetch;
        update-rollback: root.update-rollback;
        update-can-elevate: root.update-can-elevate;
        update-reason: root.update-reason;
        update-progress: root.update-progress;
        update-can-install: root.update-can-install;
        update-channel: root.update-channel;
        update-auto: root.update-auto;
        install-note: root.install-note;
        connected: root.connected;
        device-name: root.device-name;
        firmware: root.firmware;
        band-count: root.band-count;
        devices-clicked => { root.toggle-devices(); }
        opt-fullscreen: root.opt-fullscreen;
        opt-watch: root.opt-watch;
        opt-prefetch: root.opt-prefetch;
        opt-history: root.opt-history;
        motion-labels: root.motion-labels;
        opt-motion: root.opt-motion;
        set-motion(i) => { root.set-motion(i); }
        switched(k, v) => { root.set-switch(k, v); }
        about-text: root.about-text;
        closed => { root.nav-pop(); }
        dark-picked(v) => { root.set-dark(v); }
        readout-picked(v) => { root.set-readout(v); }
        accent-picked(i) => { root.set-accent(i); }
        skin-picked(i) => { root.set-skin(i); }
        welcome-again => { root.show-welcome(); }
        check-clicked => { root.check-update(); }
        install-clicked => { root.install-update(); }
        skip-clicked => { root.skip-update(); }
        channel-picked(i) => { root.set-channel(i); }
        auto-picked(v) => { root.set-auto-update(v); }
        logs-clicked => { root.open-logs(); }
        notes-clicked => { root.open-notes(); }
        copy-clicked => { root.copy-diagnostics(); }
        copy-command => { root.copy-update-command(); }
        whatsnew-clicked => { root.show-whatsnew(); }
        preview-notes => { root.preview-whatsnew(); }
        restart-clicked => { root.restart-app(); }
    }
    if root.nav == "devices": DevicesSheet {
        back-to: root.nav-under;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(660px, root.width - 56px);
        height: min(660px, root.height - 60px);
        rows: root.device-rows;
        note: root.device-note;
        closed => { root.nav-pop(); }
    }
    if root.nav == "whatsnew": WhatsNew {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(560px, root.width - 80px);
        height: min(500px, root.height - 120px);
        version: root.whatsnew-version;
        from-version: root.whatsnew-from;
        preview: root.whatsnew-preview;
        back-to: root.nav-under;
        can-install: root.update-can-install || root.update-can-elevate;
        notes: root.whatsnew-notes;
        dismissed => { root.nav-pop(); }
        changelog => { root.open-notes(); }
        install => { root.install-update(); }
    }
    if root.nav == "library": LibrarySheet {
        back-to: root.nav-under;
        x: (root.width - self.width) / 2;
        y: 60px;
        // The widest of the three it replaces. The community rows carry a thumbnail
        // and a name and an author, and were the reason 760 was picked; the others
        // are no worse for the room.
        width: min(760px, root.width - 80px);
        height: root.height - 130px;
        tab: root.lib-tab;
        note: root.lib-note;
        closed => { root.nav-pop(); }
        tab-picked(i) => { root.library-tab(i); }

        profiles: root.prof-rows;
        profile-count: root.prof-count;
        named(t) => { root.profile-name-edited(t); }
        saved => { root.profile-save(); }
        profile-applied(n) => { root.profile-apply(n); }
        profile-removed(n) => { root.profile-delete(n); }

        history: root.history-rows;
        history-count: root.history-count;
        history-applied(f) => { root.history-apply(f); }
        history-kept(f) => { root.history-keep(f); }
        history-cleared => { root.history-clear(); }

        hub-rows: root.hub-rows;
        hub-count: root.hub-count;
        hub-busy: root.hub-busy;
        sorts: root.hub-sorts;
        sort-index: root.hub-sort;
        own-only: root.hub-own;
        shapes: root.hub-shapes;
        shape: root.hub-shape;
        hub-searched(t) => { root.community-search(t); }
        hub-reloaded => { root.community-reload(); }
        hub-applied(u) => { root.community-apply(u); }
        sorted(i) => { root.community-sort(i); }
        own-picked(v) => { root.community-own(v); }
        shape-picked(n) => { root.community-shape(n); }

        aeq-rows: root.aeq-rows;
        aeq-count: root.aeq-count;
        aeq-busy: root.aeq-busy;
        sources: root.aeq-sources;
        source: root.aeq-source;
        aeq-searched(t) => { root.autoeq-search(t); }
        aeq-reloaded => { root.autoeq-reload(); }
        aeq-picked(m, sc, f) => { root.autoeq-pick(m, sc, f); }
        source-picked(n) => { root.autoeq-source(n); }
    }
    if root.nav == "help": HelpSheet {
        back-to: root.nav-under;
        pages: root.guide-pages;
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(760px, root.width - 56px);
        height: clamp(self.wanted, 380px, min(760px, root.height - 60px));
        closed => { root.nav-pop(); }
    }

    // Last child, so it covers everything — including a settings sheet that may have
    // been what summoned it back.
    // ── the walkthrough ──
    //
    // A spotlight over the real controls, not a slideshow of screenshots. The target
    // rectangle is read from the element itself with `absolute-position`, so the tour
    // cannot drift out of step with the layout the way a list of hardcoded
    // coordinates would the first time a row changed height.
    //
    // The dimming is four rectangles around the hole rather than one with a hole cut
    // in it, because there is no "cut a hole" in a renderer that composites rectangles
    // — and four is cheap, exact, and needs no mask.
    if root.tour-step >= 0: spot := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        property <length> tx: root.tour-step == 0 ? ctl-row.absolute-position.x
            : root.tour-step == 1 ? preset-row.absolute-position.x
            : root.tour-step == 2 ? graph.absolute-position.x
            : root.tour-step == 3 ? band-row.absolute-position.x
            : act-bar.absolute-position.x;
        property <length> ty: root.tour-step == 0 ? ctl-row.absolute-position.y
            : root.tour-step == 1 ? preset-row.absolute-position.y
            : root.tour-step == 2 ? graph.absolute-position.y
            : root.tour-step == 3 ? band-row.absolute-position.y
            : act-bar.absolute-position.y;
        property <length> tw: root.tour-step == 0 ? ctl-row.width
            : root.tour-step == 1 ? preset-row.width
            : root.tour-step == 2 ? graph.width
            : root.tour-step == 3 ? band-row.width
            : act-bar.width;
        property <length> th: root.tour-step == 0 ? ctl-row.height
            : root.tour-step == 1 ? preset-row.height
            : root.tour-step == 2 ? graph.height
            : root.tour-step == 3 ? band-row.height
            : act-bar.height;

        property <length> pad: 8px;
        property <length> hx: self.tx - self.pad;
        property <length> hy: self.ty - self.pad;
        property <length> hw: self.tw + self.pad * 2;
        property <length> hh: self.th + self.pad * 2;

        // Four panes around the hole. A single click anywhere on them advances, so
        // the tour never traps somebody who has stopped reading.
        Rectangle { x: 0px; y: 0px; width: spot.width; height: max(0px, spot.hy); background: #0a0709cc; }
        Rectangle { x: 0px; y: spot.hy + spot.hh; width: spot.width; height: max(0px, spot.height - (spot.hy + spot.hh)); background: #0a0709cc; }
        Rectangle { x: 0px; y: spot.hy; width: max(0px, spot.hx); height: spot.hh; background: #0a0709cc; }
        Rectangle { x: spot.hx + spot.hw; y: spot.hy; width: max(0px, spot.width - (spot.hx + spot.hw)); height: spot.hh; background: #0a0709cc; }

        // The ring around what is being talked about.
        Rectangle {
            x: spot.hx;
            y: spot.hy;
            width: spot.hw;
            height: spot.hh;
            border-radius: Theme.r-md;
            border-width: 2px;
            border-color: Theme.accent;
            animate x, y, width, height { duration: Theme.settle; easing: Theme.ease-enter; }
        }

        TouchArea { clicked => { root.tour-next(); } }

        // The caption, placed under the target unless that would run off the bottom.
        Rectangle {
            property <bool> below: spot.hy + spot.hh + 132px < spot.height;
            x: min(max(14px, spot.hx), spot.width - self.width - 14px);
            y: self.below ? spot.hy + spot.hh + 12px : max(14px, spot.hy - self.height - 12px);
            width: 420px;
            height: cap.preferred-height + 26px;
            border-radius: Theme.r-md;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.accent;
            animate x, y { duration: Theme.settle; easing: Theme.ease-enter; }
            cap := VerticalLayout {
                padding: 13px;
                spacing: 5px;
                Text {
                    text: "STEP \{root.tour-step + 1} OF 5";
                    color: Theme.accent;
                    font-family: Theme.mono;
                    font-size: 9.5px;
                    font-weight: 700;
                    letter-spacing: 1.3px;
                }
                Text {
                    text: root.tour-head;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.tour-body;
                    color: Theme.sub;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 8px;
                    TextBtn {
                        label: "Skip";
                        icon: Icons.close;
                        clicked => { root.tour-end(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    TextBtn {
                        label: root.tour-step == 4 ? "Done" : "Next";
                        icon: root.tour-step == 4 ? Icons.check : Icons.show-chart;
                        primary: true;
                        clicked => { root.tour-next(); }
                    }
                }
            }
        }
    }

    if root.welcome-open: Welcome {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        connected: root.connected;
        device-name: root.device-name;
        started => { root.dismiss-welcome(); }
        guide => { root.dismiss-welcome(); root.toggle-help(); }
        devices => { root.toggle-devices(); }
        tour => { root.dismiss-welcome(); root.start-tour(); }
    }

    if root.preview-open: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #0a0709aa;
        TouchArea { clicked => { root.preview-close(); } }
    }
    if root.preview-open: PreviewDialog {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(640px, root.width - 100px);
        height: min(500px, root.height - 120px);
        title-text: root.preview-title;
        author: root.preview-author;
        desc: root.preview-desc;
        note: root.preview-note;
        curve-path: root.preview-curve-path;
        flat-path: root.preview-flat-path;
        applied => { root.preview-apply(); }
        closed => { root.preview-close(); }
    }

    // Absolutely last, so it covers the welcome screen as well — on a first run the
    // splash plays and then hands over to it.
    property <bool> splash-done: false;
    if !root.splash-done: Splash {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        done => { root.splash-done = true; }
    }
}
