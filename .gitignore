__pycache__/
*.py[cod]
.venv/
venv/

# build / packaging artifacts
/build/
/dist/
*.egg-info/
result
result-*

# Local device backups produced by --export-json
*.json
!examples/*.json
# ...but the update manifests are source, not a backup. They are what the app fetches
# when the website copy is unreachable, so they have to be committed: packaging/update.json
# on main is the stable channel, packaging/update-beta.json on test is the beta one.
!/packaging/update.json
!/packaging/update-beta.json
!/packaging/update.example.json
# the AutoEQ catalogue: generated by tools/build-autoeq-index.py, but committed —
# it is the fallback the app fetches when the website copy is unreachable
!/packaging/autoeq-index.json
site

# makepkg build artifacts — including the release tarball its `source=` downloads
/packaging/src/
/packaging/pkg/
/packaging/*.pkg.tar.*
/packaging/hub-moon-*.tar.gz

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# icon-build tool cache (the 10 MB upstream Material Symbols font)
/tools/.cache/

docs
